@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row navbar navbar-dark">
    <button type="button" class="navbar-toggler" @onclick="Alternar" aria-label="Abrir o cerrar el menú" title="Menú"></button>
    <a class="navbar-brand ps-2" href="">Galeria.Web</a>
</div>

@* Siempre renderizado (nunca detrás de un @if): el formulario de Logout necesita su
   <AntiforgeryToken /> generado en el render estático inicial (con HttpContext disponible). Si
   este bloque se crea recién más tarde, cuando el usuario despliega el menú, el token sale
   inválido porque en ese momento ya se está renderizando puramente por el circuito interactivo,
   sin HttpContext — el POST a Logout falla con AntiforgeryValidationException. Por eso el
   colapsar/desplegar es solo visual, con una clase CSS, no un @if. *@
<div class="nav-scrollable @(abierto ? "" : "nav-scrollable-colapsado")">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Resumen
            </NavLink>
        </div>

        @foreach (var item in Items)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@item.Href">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @item.Texto
                </NavLink>
            </div>
        }

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 nav-usuario">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                @* Registro público deshabilitado: v1 tiene un solo usuario, precargado por seed (ver IdentitySeeder). *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    // Menú unificado en una sola lista, sin secciones (CATÁLOGO/OPERACIÓN/...) — se sacaron a
    // pedido del usuario, no aportaban. Colapsado por default; las 3 rayas arriba a la izquierda
    // lo despliegan completo. Estado de presentación puro, se resuelve acá sin JS.
    private sealed record ItemMenu(string Texto, string Href);

    private static readonly ItemMenu[] Items =
    [
        new("Obras", "obras"),
        new("Artistas", "artistas"),
        new("Ventas", "ventas"),
        new("Retiros", "retiros"),
        new("Alquileres", "alquileres"),
        new("Devoluciones", "devoluciones"),
        new("Adelantos", "adelantos"),
        new("Liquidaciones", "liquidaciones"),
        new("Agenda de pagos", "agenda"),
        new("Cambio de precios", "precios/cambio-global"),
        new("Auditoría", "auditoria"),
        new("Rubros y técnicas", "configuracion/catalogos"),
        new("Datos de la galería", "configuracion/galeria"),
        new("Usuarios", "configuracion/usuarios")
    ];

    private bool abierto;

    private void Alternar() => abierto = !abierto;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
