@implements IDisposable

@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@* Barra superior fija, blanca, una sola vez por página: hamburguesa a la izquierda (despliega el
   panel de navegación) y usuario a la derecha (despliega Logout). Sin marca/color de fondo — el
   azul marino solo aparece en el panel de navegación cuando está desplegado. *@
<div class="topbar">
    <div class="topbar-left">
        <button type="button" class="hamburger-btn" @onclick="AlternarNav" aria-label="Abrir o cerrar el menú" title="Menú">
            <span class="hamburger-icon @(navAbierto ? "hamburger-icon-abierto" : "")"></span>
        </button>
        @if (currentUrl != "")
        {
            <button type="button" class="back-btn" onclick="navHistorial.volver()" aria-label="Volver atrás" title="Volver atrás">←</button>
        }
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="user-menu">
                <button type="button" class="user-menu-toggle" @onclick="AlternarUsuario">
                    @context.User.Identity?.Name
                </button>
                @* Igual que el panel de navegación: el formulario de Logout tiene que estar
                   siempre en el DOM (nunca detrás de un @if) para que su <AntiforgeryToken />
                   salga del render estático inicial y no del circuito interactivo — si no, el
                   token es inválido y el POST falla. Ver commit 327e7f4. *@
                <div class="user-menu-dropdown @(usuarioAbierto ? "" : "user-menu-dropdown-oculto")">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="user-menu-logout">Cerrar sesión</button>
                    </form>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <NavLink class="user-menu-toggle" href="Account/Login">Login</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>

@* Mismo motivo que el formulario de Logout: siempre en el DOM, el colapsar/desplegar es solo
   una clase CSS (ver commit 327e7f4). Panel superpuesto (no empuja el contenido) para no
   restarle ancho a la pantalla cuando está cerrado. *@
<div class="nav-panel @(navAbierto ? "nav-panel-abierto" : "")">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Resumen
            </NavLink>
        </div>

        @foreach (var item in Items)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@item.Href">@item.Texto</NavLink>
            </div>
        }
    </nav>
</div>

@if (navAbierto)
{
    <div class="nav-backdrop" @onclick="CerrarNav"></div>
}

@code {
    private string? currentUrl;

    // Menú unificado en una sola lista, sin secciones (CATÁLOGO/OPERACIÓN/...) — se sacaron a
    // pedido del usuario, no aportaban.
    private sealed record ItemMenu(string Texto, string Href);

    private static readonly ItemMenu[] Items =
    [
        new("Obras", "obras"),
        new("Artistas", "artistas"),
        new("Ventas", "ventas"),
        new("Retiros", "retiros"),
        new("Alquileres", "alquileres"),
        new("Devoluciones", "devoluciones"),
        new("Adelantos", "adelantos"),
        new("Liquidaciones", "liquidaciones"),
        new("Agenda de pagos", "agenda"),
        new("Cambio de precios", "precios/cambio-global"),
        new("Auditoría", "auditoria"),
        new("Rubros y técnicas", "configuracion/catalogos"),
        new("Datos de la galería", "configuracion/galeria"),
        new("Usuarios", "configuracion/usuarios")
    ];

    private bool navAbierto;
    private bool usuarioAbierto;

    private void AlternarNav()
    {
        navAbierto = !navAbierto;
        usuarioAbierto = false;
    }

    private void CerrarNav() => navAbierto = false;

    private void AlternarUsuario()
    {
        usuarioAbierto = !usuarioAbierto;
        navAbierto = false;
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Registra la página de entrada en la pila de "volver atrás" (ver app.js) — las
            // navegaciones siguientes las registra OnLocationChanged, pero la primera no dispara
            // ese evento.
            await JS.InvokeVoidAsync("navHistorial.registrar", currentUrl);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        navAbierto = false;
        _ = JS.InvokeVoidAsync("navHistorial.registrar", currentUrl);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
