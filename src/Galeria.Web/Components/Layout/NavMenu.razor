@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Galeria.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @* Resumen y Login quedan fuera de los grupos a propósito (requerimiento 15). *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Resumen
            </NavLink>
        </div>

        @foreach (var grupo in Grupos)
        {
            <div class="nav-group-header px-3" @onclick="() => Alternar(grupo.Titulo)">
                <span class="nav-group-flecha">@(EstaAbierto(grupo.Titulo) ? "▾" : "▸")</span> @grupo.Titulo
            </div>

            if (EstaAbierto(grupo.Titulo))
            {
                @foreach (var item in grupo.Items)
                {
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link" href="@item.Href">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @item.Texto
                        </NavLink>
                    </div>
                }
            }
        }

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                @* Registro público deshabilitado: v1 tiene un solo usuario, precargado por seed (ver IdentitySeeder). *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    // Agrupación colapsable propuesta por el requerimiento 15. Colapsar/expandir es estado de
    // presentación puro — se resuelve en el propio componente en vez de sumar una dependencia de
    // JS (Bootstrap Collapse) que este layout todavía no carga.
    private sealed record ItemMenu(string Texto, string Href);
    private sealed record GrupoMenu(string Titulo, ItemMenu[] Items);

    private static readonly GrupoMenu[] Grupos =
    [
        new("CATÁLOGO", [new("Obras", "obras"), new("Artistas", "artistas")]),
        new("OPERACIÓN", [new("Ventas", "ventas"), new("Retiros", "retiros"), new("Alquileres", "alquileres"), new("Devoluciones", "devoluciones")]),
        new("PAGOS", [new("Adelantos", "adelantos"), new("Liquidaciones", "liquidaciones")]),
        new("CONTROL", [new("Auditoría", "auditoria")]),
        new("SISTEMA", [new("Configuración", "configuracion/catalogos")])
    ];

    private readonly HashSet<string> gruposCerrados = [];

    private bool EstaAbierto(string titulo) => !gruposCerrados.Contains(titulo);

    private void Alternar(string titulo)
    {
        if (!gruposCerrados.Add(titulo))
        {
            gruposCerrados.Remove(titulo);
        }
    }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
