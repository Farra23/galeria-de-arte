@page "/retiros"
@attribute [Authorize]
@using Galeria.Application.Artistas
@using Galeria.Application.Retiros
@using Galeria.Domain.Enums
@inject RetiroService RetiroService
@inject ArtistaService ArtistaService
@inject NavigationManager NavigationManager

<PageTitle>Retiros</PageTitle>
<HeadContent>
    <meta name="description" content="Listado de retiros temporales y definitivos, con devolución de un clic." />
</HeadContent>

<h1>Retiros</h1>

@if (mensaje is not null)
{
    <div class="alert alert-success">@mensaje</div>
}

<div class="row mb-3 g-2">
    <div class="col-md-4">
        <input class="form-control" placeholder="Buscar por obra o artista..."
               @bind="texto" @bind:event="oninput" @bind:after='() => IrA("q", texto)' />
    </div>
    <div class="col-md-3">
        <select class="form-select" value="@(ArtistaId?.ToString() ?? "")" @onchange='e => IrA("artista", ParseIntOrNull(e.Value))'>
            <option value="">Todos los artistas</option>
            @if (artistas is not null)
            {
                @foreach (var artista in artistas)
                {
                    <option value="@artista.Id">@artista.NombreCompleto</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" value="@(TipoTexto ?? "")" @onchange='e => IrA("tipo", e.Value?.ToString())'>
            <option value="">Cualquier tipo</option>
            <option value="Temporal">Temporal</option>
            <option value="Definitivo">Definitivo</option>
        </select>
    </div>
    <div class="col-md-3 text-end">
        <a class="btn btn-outline-secondary" href="@EnlaceExportarCsv()" target="_blank">Exportar CSV</a>
        <a class="btn btn-primary" href="retiros/nueva">+ Nuevo retiro</a>
    </div>
</div>

@if (retiros is null)
{
    <p><em>Cargando...</em></p>
}
else if (retiros.Count == 0)
{
    <p>No hay retiros que coincidan con los filtros.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th role="button" @onclick="() => OrdenarPor(OrdenRetiro.Fecha)">Fecha @Flecha(OrdenRetiro.Fecha)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenRetiro.Artista)">Artista @Flecha(OrdenRetiro.Artista)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenRetiro.Codigo)">Código @Flecha(OrdenRetiro.Codigo)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenRetiro.Obra)">Obra @Flecha(OrdenRetiro.Obra)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenRetiro.Tipo)">Tipo @Flecha(OrdenRetiro.Tipo)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenRetiro.Motivo)">Motivo @Flecha(OrdenRetiro.Motivo)</th>
                <th>Estado</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var retiro in retiros)
            {
                <tr>
                    <td>@retiro.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@retiro.ArtistaNombre</td>
                    <td>@retiro.CodigoObra</td>
                    <td>@retiro.Titulo</td>
                    <td>@retiro.Tipo</td>
                    <td>@retiro.Motivo</td>
                    <td>
                        @if (retiro.EstaDevuelto)
                        {
                            <span class="badge bg-secondary">Devuelto</span>
                        }
                        else if (retiro.EstaVencido)
                        {
                            <span class="badge bg-danger">Vencido</span>
                        }
                        else if (retiro.Tipo == TipoRetiro.Temporal)
                        {
                            <span class="badge bg-warning text-dark">Fuera de stock</span>
                        }
                        else
                        {
                            <span class="badge bg-dark">Definitivo</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" href="@($"retiros/{retiro.Id}/pdf")" target="_blank">PDF</a>
                        @if (!string.IsNullOrWhiteSpace(retiro.ArtistaCorreo))
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="@EnlaceMail(retiro)" title="Avisar por mail">✉</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(retiro.ArtistaCelular))
                        {
                            <a class="btn btn-sm btn-outline-success" href="@EnlaceWhatsApp(retiro)" target="_blank" title="Avisar por WhatsApp">WA</a>
                        }
                        @if (retiro.Tipo == TipoRetiro.Temporal && !retiro.EstaDevuelto)
                        {
                            <button class="btn btn-sm btn-outline-primary" disabled="@(procesandoId == retiro.Id)" @onclick="() => DevolverAsync(retiro.Id)">@(procesandoId == retiro.Id ? "Procesando…" : "Devolver al stock")</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? TextoLibre { get; set; }
    [SupplyParameterFromQuery(Name = "artista")] public int? ArtistaId { get; set; }
    [SupplyParameterFromQuery(Name = "tipo")] public string? TipoTexto { get; set; }
    [SupplyParameterFromQuery(Name = "orden")] public string? OrdenTexto { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? OrdenDescendente { get; set; }

    private TipoRetiro? TipoFiltro => Enum.TryParse<TipoRetiro>(TipoTexto, out var t) ? t : null;
    private OrdenRetiro? Orden => Enum.TryParse<OrdenRetiro>(OrdenTexto, out var o) ? o : null;
    private OrdenRetiro OrdenActual => Orden ?? OrdenRetiro.Fecha;
    private bool DescActual => OrdenDescendente ?? true;

    private List<RetiroListItem>? retiros;
    private List<ArtistaOpcion>? artistas;
    private string? texto;
    private string? mensaje;
    private int? procesandoId;

    protected override async Task OnInitializedAsync()
    {
        artistas = await ArtistaService.ListarParaSeleccionAsync();
        texto = TextoLibre;
    }

    protected override async Task OnParametersSetAsync()
    {
        texto = TextoLibre;
        retiros = await RetiroService.BuscarAsync(FiltroActual());
    }

    private async Task DevolverAsync(int retiroId)
    {
        if (procesandoId is not null) return;
        procesandoId = retiroId;
        mensaje = null;

        try
        {
            await RetiroService.DevolverAsync(retiroId);
            mensaje = "La pieza volvió al stock.";
            retiros = await RetiroService.BuscarAsync(FiltroActual());
        }
        finally
        {
            procesandoId = null;
        }
    }

    private RetiroFiltro FiltroActual() => new(TextoLibre, ArtistaId, TipoFiltro, Orden: OrdenActual, OrdenDescendente: DescActual);

    private void IrA(string clave, object? valor) =>
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> { [clave] = valor }), replace: true);

    private void OrdenarPor(OrdenRetiro campo)
    {
        var descNuevo = OrdenActual == campo ? !DescActual : true;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["orden"] = campo.ToString(),
            ["desc"] = descNuevo.ToString().ToLowerInvariant()
        }), replace: true);
    }

    private string Flecha(OrdenRetiro campo) => OrdenActual != campo ? "" : (DescActual ? " ▼" : " ▲");

    private static int? ParseIntOrNull(object? valor) => int.TryParse(valor?.ToString(), out var n) ? n : null;

    private string EnlaceExportarCsv() => "retiros/exportar.csv" + new Uri(NavigationManager.Uri).Query;

    private static string ArmarMensaje(RetiroListItem retiro)
    {
        var accion = retiro.Tipo == TipoRetiro.Temporal ? "retiró temporalmente" : "retiró definitivamente";
        var devolucion = retiro.FechaEstimadaDevolucion is not null
            ? $" Fecha estimada de devolución: {retiro.FechaEstimadaDevolucion:dd/MM/yyyy}."
            : "";
        return $"Le informamos que se {accion} la obra \"{retiro.Titulo}\" (código {retiro.CodigoObra}) el {retiro.Fecha:dd/MM/yyyy}.{devolucion}";
    }

    private static string EnlaceMail(RetiroListItem retiro)
    {
        var asunto = Uri.EscapeDataString("Retiro de obra");
        var cuerpo = Uri.EscapeDataString(ArmarMensaje(retiro));
        return $"mailto:{retiro.ArtistaCorreo}?subject={asunto}&body={cuerpo}";
    }

    private static string EnlaceWhatsApp(RetiroListItem retiro)
    {
        var numero = new string(retiro.ArtistaCelular!.Where(char.IsDigit).ToArray());
        var texto = Uri.EscapeDataString(ArmarMensaje(retiro));
        return $"https://wa.me/{numero}?text={texto}";
    }
}
