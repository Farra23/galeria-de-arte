@page "/retiros/nueva"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Galeria.Application.Obras
@using Galeria.Application.Retiros
@using Galeria.Domain.Enums
@inject RetiroService RetiroService
@inject NavigationManager NavigationManager

<PageTitle>Nuevo retiro</PageTitle>
<HeadContent>
    <meta name="description" content="Registrar el retiro temporal o definitivo de una o varias obras." />
</HeadContent>

<div class="page-form">
<h1>Nuevo retiro</h1>

@if (error is not null)
{
    <ul class="text-danger" role="alert"><li>@error</li></ul>
}

@if (!continuar)
{
    <div class="mb-3">
        <label class="form-label">Buscar obra por código, nombre o artista</label>
        <input class="form-control" @bind="texto" @bind:event="oninput" @bind:after="BuscarAsync" autofocus />
    </div>

    @if (resultados is not null)
    {
        @if (resultados.Count == 0)
        {
            <p class="mt-3">No se encontraron obras disponibles con ese criterio.</p>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-striped mt-3">
                <thead><tr><th></th><th>Código</th><th>Nombre</th><th>Artista</th><th class="text-end">Stock</th></tr></thead>
                <tbody>
                    @foreach (var item in resultados)
                    {
                        <tr style="cursor:pointer" @onclick="() => Marcar(item, true)">
                            <td><input type="checkbox" class="form-check-input" checked="@seleccion.ContainsKey(item.Id)" @onclick:stopPropagation="true" @onclick="() => Alternar(item)" /></td>
                            <td>@item.CodigoVisible</td>
                            <td>@item.Titulo</td>
                            <td>@item.ArtistaNombre</td>
                            <td class="text-end">@item.Existencia</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }

    @if (seleccion.Count > 0)
    {
        <div class="alert alert-light border d-flex justify-content-between align-items-center">
            <span>@seleccion.Count obra(s) marcada(s) para retirar.</span>
            <button type="button" class="btn btn-primary" @onclick="() => continuar = true">Continuar</button>
        </div>
    }
}
else
{
    <div>
        <h2 class="h5">@seleccion.Count obra(s) a retirar</h2>
        <ul class="list-group mb-3">
            @foreach (var item in seleccion.Values)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@item.CodigoVisible — @item.Titulo (@item.ArtistaNombre, stock @item.Existencia)</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Quitar(item.Id)">Quitar</button>
                </li>
            }
        </ul>

        <EditForm Model="Input" OnValidSubmit="ConfirmarAsync" FormName="nuevo-retiro" data-enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Cantidad (por obra)</label>
                    <InputNumber class="form-control" @bind-Value="Input.Cantidad" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha</label>
                    <InputDate class="form-control" @bind-Value="Input.Fecha" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Tipo</label>
                    <InputSelect class="form-select" @bind-Value="Input.Tipo">
                        <option value="@TipoRetiro.Temporal">Temporal</option>
                        <option value="@TipoRetiro.Definitivo">Definitivo</option>
                    </InputSelect>
                </div>
                @if (Input.Tipo == TipoRetiro.Temporal)
                {
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Devolución estimada</label>
                        <InputDate class="form-control" @bind-Value="Input.FechaEstimadaDevolucion" />
                    </div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Motivo</label>
                <InputTextArea class="form-control" @bind-Value="Input.Motivo" rows="2" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : seleccion.Count > 1 ? $"Confirmar {seleccion.Count} retiros" : "Confirmar retiro")</button>
            <button type="button" class="btn btn-link text-danger" @onclick="Cancelar">Cancelar</button>
        </EditForm>
    </div>
}
</div>

<ConfirmModal @ref="confirmModal" />

@code {
    private string? texto;
    private List<ObraParaOperacion>? resultados;
    private readonly Dictionary<int, ObraParaOperacion> seleccion = [];
    private bool continuar;
    private string? error;
    private int guardandoFlag;
    private bool guardando => guardandoFlag != 0;
    private InputModel Input { get; set; } = new();
    private ConfirmModal confirmModal = default!;

    private async Task BuscarAsync() => resultados = await RetiroService.BuscarObrasDisponiblesAsync(texto);

    private void Marcar(ObraParaOperacion item, bool valor)
    {
        if (valor) seleccion[item.Id] = item;
        else seleccion.Remove(item.Id);
    }

    private void Alternar(ObraParaOperacion item) => Marcar(item, !seleccion.ContainsKey(item.Id));

    private void Quitar(int obraId)
    {
        seleccion.Remove(obraId);
        if (seleccion.Count == 0)
        {
            Cancelar();
        }
    }

    private void Cancelar()
    {
        seleccion.Clear();
        continuar = false;
        error = null;
        Input = new InputModel { Fecha = DateTime.Now };
    }

    private void ConfirmarAsync()
    {
        error = null;

        var mensaje = seleccion.Count == 1
            ? $"¿Confirmás el retiro de \"{seleccion.Values.First().Titulo}\"?"
            : $"¿Confirmás el retiro de las {seleccion.Count} obras marcadas?";

        if (Input.Tipo == TipoRetiro.Definitivo)
        {
            confirmModal.Mostrar(
                "Confirmar retiro definitivo",
                mensaje + " A diferencia de un retiro temporal, estas obras no tienen un botón para volver a habilitarlas.",
                RegistrarAsync,
                "Retirar definitivamente");
            return;
        }

        confirmModal.Mostrar("Confirmar retiro", mensaje, RegistrarAsync, "Confirmar retiro");
    }

    private async Task RegistrarAsync()
    {
        if (Interlocked.CompareExchange(ref guardandoFlag, 1, 0) != 0) return;

        try
        {
            var fallidas = new List<string>();

            foreach (var item in seleccion.Values.ToList())
            {
                try
                {
                    var request = new RegistrarRetiroRequest(
                        item.Id,
                        DateOnly.FromDateTime(Input.Fecha),
                        Input.Cantidad,
                        Input.Tipo,
                        Input.Motivo,
                        Input.FechaEstimadaDevolucion.HasValue ? DateOnly.FromDateTime(Input.FechaEstimadaDevolucion.Value) : null);

                    await RetiroService.RegistrarAsync(request);
                    seleccion.Remove(item.Id);
                }
                catch (InvalidOperationException ex)
                {
                    fallidas.Add($"{item.CodigoVisible} — {item.Titulo}: {ex.Message}");
                }
            }

            if (fallidas.Count > 0)
            {
                error = "No se pudo registrar el retiro de: " + string.Join(" | ", fallidas);
            }

            if (seleccion.Count == 0)
            {
                NavigationManager.NavigateTo("retiros");
            }
        }
        finally
        {
            guardandoFlag = 0;
            StateHasChanged();
        }
    }

    private sealed class InputModel
    {
        [Range(1, 9999, ErrorMessage = "La cantidad tiene que ser al menos 1.")]
        public int Cantidad { get; set; } = 1;

        public DateTime Fecha { get; set; } = DateTime.Now;

        public TipoRetiro Tipo { get; set; } = TipoRetiro.Temporal;

        public DateTime? FechaEstimadaDevolucion { get; set; }

        [MaxLength(500)]
        public string? Motivo { get; set; }
    }
}
