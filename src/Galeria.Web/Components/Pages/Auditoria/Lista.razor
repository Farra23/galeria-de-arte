@page "/auditoria"
@attribute [Authorize]
@using Galeria.Application.Auditorias
@inject AuditoriaService AuditoriaService
@inject NavigationManager NavigationManager

<PageTitle>Auditoría</PageTitle>
<HeadContent>
    <meta name="description" content="Historial de cambios del sistema: quién, cuándo y qué se modificó." />
</HeadContent>

<h1>Auditoría</h1>

<div class="row mb-3 g-2">
    <div class="col-md-3">
        <input class="form-control" placeholder="Buscar por usuario..."
               @bind="usuario" @bind:event="oninput" @bind:after='() => IrA("usuario", usuario)' />
    </div>
    <div class="col-md-2">
        <select class="form-select" value="@(Pantalla ?? "")" @onchange='e => IrA("pantalla", e.Value?.ToString())'>
            <option value="">Cualquier pantalla</option>
            @foreach (var pantalla in PantallasConocidas)
            {
                <option value="@pantalla">@pantalla</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" value="@(TipoOperacion ?? "")" @onchange='e => IrA("tipo", e.Value?.ToString())'>
            <option value="">Cualquier operación</option>
            <option value="Alta">Alta</option>
            <option value="Modificacion">Modificación</option>
            <option value="Baja">Baja</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" class="form-control" value="@(FechaDesde?.ToString("yyyy-MM-dd"))"
               @onchange='e => IrA("desde", ParseFechaOrNull(e.Value))' />
    </div>
    <div class="col-md-2">
        <input type="date" class="form-control" value="@(FechaHasta?.ToString("yyyy-MM-dd"))"
               @onchange='e => IrA("hasta", ParseFechaOrNull(e.Value))' />
    </div>
    <div class="col-md-1">
        <button type="button" class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("auditoria")'>Limpiar</button>
    </div>
</div>

<div class="mb-3">
    <a class="btn btn-outline-secondary" href="@EnlaceExportarCsv()" target="_blank">Exportar CSV</a>
</div>

@if (registros is null)
{
    <p><em>Cargando...</em></p>
}
else if (registros.Count == 0)
{
    <p>No hay registros de auditoría que coincidan con los filtros.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th role="button" @onclick="() => OrdenarPor(OrdenAuditoria.FechaHora)">Fecha y hora @Flecha(OrdenAuditoria.FechaHora)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenAuditoria.Usuario)">Usuario @Flecha(OrdenAuditoria.Usuario)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenAuditoria.Pantalla)">Pantalla @Flecha(OrdenAuditoria.Pantalla)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenAuditoria.Operacion)">Operación @Flecha(OrdenAuditoria.Operacion)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenAuditoria.Tabla)">Tabla @Flecha(OrdenAuditoria.Tabla)</th>
                <th>Campo</th>
                <th>Anterior</th>
                <th>Nuevo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var registro in registros)
            {
                <tr>
                    <td>@registro.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@registro.NombreUsuario</td>
                    <td>@registro.Pantalla</td>
                    <td>@registro.TipoOperacion</td>
                    <td>@registro.Tabla</td>
                    <td>@registro.Columna</td>
                    <td>@registro.ValorAnterior</td>
                    <td>@registro.ValorNuevo</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (registros.Count >= Galeria.Application.Common.Listados.Tope)
    {
        <p class="text-body-secondary">Mostrando los @Galeria.Application.Common.Listados.Tope registros más recientes que coinciden con el filtro — acotá la búsqueda para ver más precisión.</p>
    }
}

@code {
    private static readonly string[] PantallasConocidas =
        ["Obras", "Artistas", "Ventas", "Retiros", "Alquileres", "Devoluciones", "Adelantos", "Liquidaciones"];

    [SupplyParameterFromQuery(Name = "usuario")] public string? Usuario { get; set; }
    [SupplyParameterFromQuery(Name = "pantalla")] public string? Pantalla { get; set; }
    [SupplyParameterFromQuery(Name = "tipo")] public string? TipoOperacion { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] public DateOnly? FechaDesde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] public DateOnly? FechaHasta { get; set; }
    [SupplyParameterFromQuery(Name = "orden")] public string? OrdenTexto { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? OrdenDescendente { get; set; }

    private OrdenAuditoria? Orden => Enum.TryParse<OrdenAuditoria>(OrdenTexto, out var o) ? o : null;
    private OrdenAuditoria OrdenActual => Orden ?? OrdenAuditoria.FechaHora;
    private bool DescActual => OrdenDescendente ?? true;

    private List<AuditoriaListItem>? registros;
    private string? usuario;

    protected override async Task OnInitializedAsync()
    {
        usuario = Usuario;
        await CargarAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        usuario = Usuario;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var filtro = new AuditoriaFiltro(FechaDesde, FechaHasta, Usuario, Pantalla, TipoOperacion, Orden: OrdenActual, OrdenDescendente: DescActual);
        registros = await AuditoriaService.BuscarAsync(filtro);
    }

    private void IrA(string clave, object? valor) =>
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> { [clave] = valor }), replace: true);

    private void OrdenarPor(OrdenAuditoria campo)
    {
        var descNuevo = OrdenActual == campo ? !DescActual : true;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["orden"] = campo.ToString(),
            ["desc"] = descNuevo.ToString().ToLowerInvariant()
        }), replace: true);
    }

    private string Flecha(OrdenAuditoria campo) => OrdenActual != campo ? "" : (DescActual ? " ▼" : " ▲");

    private static string? ParseFechaOrNull(object? valor) =>
        DateOnly.TryParse(valor?.ToString(), out var f) ? f.ToString("yyyy-MM-dd") : null;

    private string EnlaceExportarCsv() => "auditoria/exportar.csv" + new Uri(NavigationManager.Uri).Query;
}
