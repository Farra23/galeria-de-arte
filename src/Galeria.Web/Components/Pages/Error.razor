@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="login-card">
    <h1 class="login-card-title text-danger">Ocurrió un error</h1>
    <p class="login-card-subtitle">No se pudo procesar la solicitud. Volvé al inicio e intentá de nuevo.</p>

    @if (ShowRequestId)
    {
        <p class="text-body-secondary small">
            <strong>ID de solicitud:</strong> <code>@RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-primary w-100">Volver al inicio</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
