@page "/liquidaciones/{Id:int}"
@attribute [Authorize]
@using Galeria.Application.Liquidaciones
@using Galeria.Application.Parametros
@using Galeria.Domain.Entities
@inject LiquidacionService LiquidacionService
@inject IParametroRepository ParametroRepository

<PageTitle>Liquidación</PageTitle>
<HeadContent>
    <meta name="description" content="Comprobante de liquidación confirmada, imprimible." />
</HeadContent>

@if (detalle is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="page-form">
        <div class="mb-3 d-print-none">
            <button class="btn btn-primary" onclick="window.print()">Imprimir</button>
            <a class="btn btn-outline-primary" href="@($"liquidaciones/{detalle.Id}/pdf")" target="_blank">Descargar PDF</a>
            @if (!string.IsNullOrWhiteSpace(detalle.ArtistaCorreo))
            {
                <a class="btn btn-outline-secondary" href="@EnlaceMail()">Enviar por mail</a>
            }
            @if (!string.IsNullOrWhiteSpace(detalle.ArtistaCelular))
            {
                <a class="btn btn-outline-success" href="@EnlaceWhatsApp()" target="_blank">Enviar por WhatsApp</a>
            }
            <a class="btn btn-link" href="liquidaciones">Volver a Liquidaciones</a>
        </div>

        <div class="border rounded p-4">
            <div class="d-flex justify-content-between">
                <div>
                    <h5>@nombreGaleria</h5>
                    @if (!string.IsNullOrWhiteSpace(direccionGaleria))
                    {
                        <p class="text-body-secondary mb-0">@direccionGaleria</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(telefonoGaleria))
                    {
                        <p class="text-body-secondary mb-0">@telefonoGaleria</p>
                    }
                    <p class="text-body-secondary mb-0">Comprobante de liquidación a artista</p>
                </div>
                <div class="text-end">
                    <h1 class="h3">Liquidación N.º @detalle.NumeroCorrelativo.ToString("D6")</h1>
                    <p class="text-body-secondary">Fecha de emisión: <strong>@detalle.Fecha.ToString("dd/MM/yyyy")</strong></p>
                </div>
            </div>

            <hr />
            <p><strong>Artista:</strong> @detalle.ArtistaNombre — <strong>Moneda:</strong> @Formato.Simbolo(detalle.Moneda)</p>

            <div class="table-responsive">
            <table class="table table-sm table-striped mt-3">
                <thead>
                    <tr><th>Fecha</th><th>Tipo</th><th>Código</th><th>Obra</th><th class="text-end">Cant.</th><th class="text-end">Monto</th><th>Detalle</th></tr>
                </thead>
                <tbody>
                    @foreach (var linea in detalle.Lineas)
                    {
                        <tr>
                            <td>@linea.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@TipoTexto(linea.Tipo)</td>
                            <td>@linea.CodigoObra</td>
                            <td>@linea.NombreObra</td>
                            <td class="text-end">@linea.Cantidad</td>
                            <td class="text-end">@Formato.Monto(linea.MontoTotal, detalle.Moneda)</td>
                            <td>@linea.Observaciones</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            <dl class="row">
                <dt class="col-sm-3">Total bruto</dt><dd class="col-sm-9">@Formato.Monto(detalle.TotalBruto, detalle.Moneda)</dd>
                <dt class="col-sm-3">Adelantos</dt><dd class="col-sm-9">@Formato.Monto(detalle.TotalAdelantos, detalle.Moneda)</dd>
                <dt class="col-sm-3 fw-bold">Total neto pagado</dt><dd class="col-sm-9 fw-bold fs-5">@Formato.Monto(detalle.TotalNeto, detalle.Moneda)</dd>
            </dl>

            <p class="text-body-secondary fst-italic">
                Esta liquidación deja constancia de las piezas vendidas, alquiladas o adelantadas que se pagaron en esta fecha.
            </p>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private LiquidacionDetalle? detalle;
    private string nombreGaleria = "Galería ACATRAS";
    private string? direccionGaleria;
    private string? telefonoGaleria;
    private string plantilla = "Estimado [nombre], adjuntamos su liquidación por [monto], emitida el [fecha].";

    protected override async Task OnInitializedAsync()
    {
        detalle = await LiquidacionService.ObtenerDetalleAsync(Id);

        var valores = await ParametroRepository.ObtenerVariosAsync(
        [
            Parametro.Claves.NombreGaleria,
            Parametro.Claves.DireccionGaleria,
            Parametro.Claves.TelefonoGaleria,
            Parametro.Claves.PlantillaLiqui
        ]);

        if (valores.TryGetValue(Parametro.Claves.NombreGaleria, out var nombre) && !string.IsNullOrWhiteSpace(nombre))
        {
            nombreGaleria = nombre;
        }

        direccionGaleria = valores.GetValueOrDefault(Parametro.Claves.DireccionGaleria);
        telefonoGaleria = valores.GetValueOrDefault(Parametro.Claves.TelefonoGaleria);

        if (valores.TryGetValue(Parametro.Claves.PlantillaLiqui, out var plantillaGuardada) && !string.IsNullOrWhiteSpace(plantillaGuardada))
        {
            plantilla = plantillaGuardada;
        }
    }

    // Sin integración de mail/WhatsApp real (requerimiento 0.3, opción recomendada para v1): un
    // mailto: abre el cliente de correo del usuario ya armado, y un link a wa.me abre WhatsApp
    // Web con el mensaje escrito — gratis, inmediato, y quien envía revisa antes de mandar.
    private string ArmarMensaje() => plantilla
        .Replace("[nombre]", detalle!.ArtistaNombre)
        .Replace("[monto]", Formato.Monto(detalle.TotalNeto, detalle.Moneda))
        .Replace("[fecha]", detalle.Fecha.ToString("dd/MM/yyyy"));

    private string EnlaceMail()
    {
        var asunto = Uri.EscapeDataString($"Liquidación N.º {detalle!.NumeroCorrelativo:D6}");
        var cuerpo = Uri.EscapeDataString(ArmarMensaje());
        return $"mailto:{detalle.ArtistaCorreo}?subject={asunto}&body={cuerpo}";
    }

    private string EnlaceWhatsApp()
    {
        var numero = new string(detalle!.ArtistaCelular!.Where(char.IsDigit).ToArray());
        var texto = Uri.EscapeDataString(ArmarMensaje());
        return $"https://wa.me/{numero}?text={texto}";
    }

    private static string TipoTexto(TipoLinea tipo) => tipo switch
    {
        TipoLinea.Venta => "Venta",
        TipoLinea.Alquiler => "Alquiler",
        TipoLinea.PagoContado => "Pago contado",
        TipoLinea.Adelanto => "Adelanto",
        TipoLinea.Devolucion => "Devolución",
        _ => tipo.ToString()
    };
}
