@page "/liquidaciones"
@attribute [Authorize]
@using Galeria.Application.Artistas
@using Galeria.Application.Liquidaciones
@inject LiquidacionService LiquidacionService
@inject ArtistaService ArtistaService
@inject NavigationManager NavigationManager

<PageTitle>Liquidaciones</PageTitle>
<HeadContent>
    <meta name="description" content="Historial de liquidaciones confirmadas por artista." />
</HeadContent>

<h1>Liquidaciones</h1>

<div class="row mb-3 g-2">
    <div class="col-md-4">
        <select class="form-select" value="@(ArtistaId?.ToString() ?? "")" @onchange='e => IrA("artista", ParseIntOrNull(e.Value))'>
            <option value="">Todos los artistas</option>
            @if (artistas is not null)
            {
                @foreach (var artista in artistas)
                {
                    <option value="@artista.Id">@artista.NombreCompleto</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4 text-end offset-md-4">
        <a class="btn btn-outline-secondary" href="@EnlaceExportarCsv()" target="_blank">Exportar CSV</a>
        <a class="btn btn-primary" href="liquidaciones/generar">+ Generar liquidación</a>
    </div>
</div>

@if (liquidaciones is null)
{
    <p><em>Cargando...</em></p>
}
else if (liquidaciones.Count == 0)
{
    <p>Todavía no hay liquidaciones confirmadas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th role="button" @onclick="() => OrdenarPor(OrdenLiquidacion.Numero)">N.º @Flecha(OrdenLiquidacion.Numero)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenLiquidacion.Fecha)">Fecha @Flecha(OrdenLiquidacion.Fecha)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenLiquidacion.Artista)">Artista @Flecha(OrdenLiquidacion.Artista)</th>
                <th role="button" class="text-end" @onclick="() => OrdenarPor(OrdenLiquidacion.Total)">Total @Flecha(OrdenLiquidacion.Total)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var liquidacion in liquidaciones)
            {
                <tr style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo($"liquidaciones/{liquidacion.Id}")'>
                    <td>@liquidacion.NumeroCorrelativo.ToString("D6")</td>
                    <td>@liquidacion.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@liquidacion.ArtistaNombre</td>
                    <td class="text-end">@Formato.Monto(liquidacion.TotalNeto, liquidacion.Moneda)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery(Name = "artista")] public int? ArtistaId { get; set; }
    [SupplyParameterFromQuery(Name = "orden")] public string? OrdenTexto { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? OrdenDescendente { get; set; }

    private OrdenLiquidacion? Orden => Enum.TryParse<OrdenLiquidacion>(OrdenTexto, out var o) ? o : null;
    private OrdenLiquidacion OrdenActual => Orden ?? OrdenLiquidacion.Numero;
    private bool DescActual => OrdenDescendente ?? true;

    private List<LiquidacionListItem>? liquidaciones;
    private List<ArtistaOpcion>? artistas;

    protected override async Task OnInitializedAsync() =>
        artistas = await ArtistaService.ListarParaSeleccionAsync();

    protected override async Task OnParametersSetAsync() =>
        liquidaciones = await LiquidacionService.BuscarAsync(new LiquidacionFiltro(ArtistaId, Orden: OrdenActual, OrdenDescendente: DescActual));

    private void IrA(string clave, object? valor) =>
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> { [clave] = valor }), replace: true);

    private void OrdenarPor(OrdenLiquidacion campo)
    {
        var descNuevo = OrdenActual == campo ? !DescActual : true;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["orden"] = campo.ToString(),
            ["desc"] = descNuevo.ToString().ToLowerInvariant()
        }), replace: true);
    }

    private string Flecha(OrdenLiquidacion campo) => OrdenActual != campo ? "" : (DescActual ? " ▼" : " ▲");

    private static int? ParseIntOrNull(object? valor) => int.TryParse(valor?.ToString(), out var n) ? n : null;

    private string EnlaceExportarCsv() => "liquidaciones/exportar.csv" + new Uri(NavigationManager.Uri).Query;
}
