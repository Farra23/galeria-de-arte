@page "/liquidaciones/generar"
@attribute [Authorize]
@using Galeria.Application.Artistas
@using Galeria.Application.Liquidaciones
@using Galeria.Application.Parametros
@using Galeria.Domain.Entities
@inject LiquidacionService LiquidacionService
@inject ArtistaService ArtistaService
@inject IParametroRepository ParametroRepository
@inject NavigationManager NavigationManager

<PageTitle>Generar liquidación</PageTitle>
<HeadContent>
    <meta name="description" content="Generar la liquidación de un artista: vista previa antes de confirmar." />
</HeadContent>

<div class="page-form">
<h1>Generar liquidación</h1>

@if (error is not null)
{
    <ul class="text-danger" role="alert"><li>@error</li></ul>
}

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Artista</label>
        <select class="form-select" @bind="artistaId">
            <option value="0">Seleccioná un artista...</option>
            @if (artistas is not null)
            {
                @foreach (var artista in artistas)
                {
                    <option value="@artista.Id">@artista.Codigo.ToString("D3") — @artista.NombreCompleto</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Moneda</label>
        <select class="form-select" @bind="moneda">
            <option value="@Moneda.Pesos">Pesos ($)</option>
            <option value="@Moneda.USD">Dólares (U$S)</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-primary" @onclick="GenerarVistaPreviaAsync">Ver vista previa</button>
    </div>
</div>

@if (vista is not null)
{
    <div class="border rounded p-3 mb-3">
        <h2 class="h5">
            @vista.ArtistaNombre — @Formato.Simbolo(vista.Moneda)
        </h2>
        <p class="text-body-secondary">
            Última liquidación: @(vista.UltimaLiquidacion?.ToString("dd/MM/yyyy") ?? "nunca se le liquidó")
        </p>
        <p class="text-body-secondary">
            Se liquida todo lo pendiente hasta el @vista.FechaCorte.ToString("dd/MM/yyyy").
            @if (vista.CantidadExcluidasDelMes > 0)
            {
                <span>Lo vendido en el mes en curso (@vista.CantidadExcluidasDelMes movimiento(s)) se liquida recién el mes que viene.</span>
            }
        </p>

        @if (vista.Lineas.Count == 0)
        {
            <p>No hay nada pendiente para liquidar a este artista en esta moneda.</p>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr><th>Fecha</th><th>Tipo</th><th>Código</th><th>Obra</th><th class="text-end">Cant.</th><th class="text-end">Monto</th><th>Detalle</th></tr>
                </thead>
                <tbody>
                    @foreach (var linea in vista.Lineas)
                    {
                        <tr>
                            <td>@linea.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@TipoTexto(linea.Tipo)</td>
                            <td>@linea.CodigoObra</td>
                            <td>@linea.NombreObra</td>
                            <td class="text-end">@linea.Cantidad</td>
                            <td class="text-end">@Formato.Monto(linea.MontoTotal, vista.Moneda)</td>
                            <td>@linea.Observaciones</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            <dl class="row">
                <dt class="col-sm-3">Total bruto</dt><dd class="col-sm-9">@Formato.Monto(vista.TotalBruto, vista.Moneda)</dd>
                <dt class="col-sm-3">Adelantos</dt><dd class="col-sm-9">@Formato.Monto(vista.TotalAdelantos, vista.Moneda)</dd>
                <dt class="col-sm-3 fw-bold">Total neto a pagar</dt><dd class="col-sm-9 fw-bold fs-5">@Formato.Monto(vista.TotalNeto, vista.Moneda)</dd>
            </dl>

            <div class="d-flex flex-wrap gap-2 align-items-center">
                <button class="btn btn-primary" disabled="@confirmando" @onclick="ConfirmarAsync">@(confirmando ? "Confirmando…" : "Confirmar liquidación")</button>
                <a class="btn btn-outline-secondary" href="@EnlacePdfVistaPrevia()" target="_blank">Descargar PDF (sin confirmar)</a>
                @if (!string.IsNullOrWhiteSpace(vista.ArtistaCorreo))
                {
                    <a class="btn btn-outline-secondary" href="@EnlaceMail()" title="Avisar por mail, sin confirmar">✉ Mail</a>
                }
                @if (!string.IsNullOrWhiteSpace(vista.ArtistaCelular))
                {
                    <a class="btn btn-outline-success" href="@EnlaceWhatsApp()" target="_blank" title="Avisar por WhatsApp, sin confirmar">WA</a>
                }
            </div>
            <p class="text-body-secondary small mt-2">
                Esto no confirma nada, es solo para mostrarle al artista cuánto le tocaría cobrar.
                "✉ Mail" y "WA" no adjuntan el PDF solos — bajalo primero y adjuntalo a mano.
            </p>
        }
    </div>
}
</div>

@code {
[SupplyParameterFromQuery(Name = "artista")] public int? ArtistaPreseleccionado { get; set; }

    private List<ArtistaOpcion>? artistas;
    private int artistaId;
    private Moneda moneda = Moneda.Pesos;
    private VistaPreviaLiquidacion? vista;
    private string? error;
    private int confirmandoFlag;
    private bool confirmando => confirmandoFlag != 0;

    // Mismo texto por defecto que Ver.razor (sin prometer un adjunto que el mailto:/wa.me no manda
    // solo — ver comentario de ArmarMensaje ahí).
    private string plantilla = "Estimado [nombre], le enviamos su liquidación por [monto], emitida el [fecha].";

    protected override async Task OnInitializedAsync()
    {
        artistas = await ArtistaService.ListarParaSeleccionAsync();

        var plantillaGuardada = await ParametroRepository.ObtenerAsync(Parametro.Claves.PlantillaLiqui);
        if (!string.IsNullOrWhiteSpace(plantillaGuardada))
        {
            plantilla = plantillaGuardada;
        }

        if (ArtistaPreseleccionado is > 0)
        {
            artistaId = ArtistaPreseleccionado.Value;
            await GenerarVistaPreviaAsync();
        }
    }

    private string EnlacePdfVistaPrevia() => $"liquidaciones/vista-previa/{artistaId}/{moneda}/pdf";

    private string ArmarMensaje() => plantilla
        .Replace("[nombre]", vista!.ArtistaNombre)
        .Replace("[monto]", Formato.Monto(vista.TotalNeto, vista.Moneda))
        .Replace("[fecha]", DateOnly.FromDateTime(DateTime.Now).ToString("dd/MM/yyyy"));

    private string EnlaceMail()
    {
        var asunto = Uri.EscapeDataString("Su liquidación (vista previa, sin confirmar)");
        var cuerpo = Uri.EscapeDataString(ArmarMensaje());
        return $"mailto:{vista!.ArtistaCorreo}?subject={asunto}&body={cuerpo}";
    }

    private string EnlaceWhatsApp()
    {
        var numero = new string(vista!.ArtistaCelular!.Where(char.IsDigit).ToArray());
        var texto = Uri.EscapeDataString(ArmarMensaje());
        return $"https://wa.me/{numero}?text={texto}";
    }

    private async Task GenerarVistaPreviaAsync()
    {
        error = null;
        vista = null;

        if (artistaId == 0)
        {
            error = "Elegí un artista.";
            return;
        }

        vista = await LiquidacionService.GenerarVistaPreviaAsync(artistaId, moneda);
    }

    private async Task ConfirmarAsync()
    {
        if (Interlocked.CompareExchange(ref confirmandoFlag, 1, 0) != 0) return;
        error = null;

        try
        {
            var liquidacionId = await LiquidacionService.ConfirmarAsync(artistaId, moneda);
            NavigationManager.NavigateTo($"liquidaciones/{liquidacionId}");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        finally
        {
            confirmandoFlag = 0;
        }
    }

    private static string TipoTexto(TipoLinea tipo) => tipo switch
    {
        TipoLinea.Venta => "Venta",
        TipoLinea.Alquiler => "Alquiler",
        TipoLinea.PagoContado => "Pago contado",
        TipoLinea.Adelanto => "Adelanto",
        TipoLinea.Devolucion => "Devolución",
        _ => tipo.ToString()
    };
}
