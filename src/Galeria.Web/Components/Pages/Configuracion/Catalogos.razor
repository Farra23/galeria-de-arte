@page "/configuracion/catalogos"
@attribute [Authorize]
@using Galeria.Application.Catalogos
@inject ICatalogoRepository CatalogoRepository

<PageTitle>Rubros y técnicas</PageTitle>
<HeadContent>
    <meta name="description" content="ABM de rubros y técnicas usados en la ficha de obra." />
</HeadContent>

<div class="page-narrow">
    <h1>Rubros y técnicas</h1>
    <p class="text-body-secondary">Nunca se borran: una baja los oculta de los desplegables pero conserva el historial de las obras que ya los usan.</p>

    <div class="row">
        <div class="col-md-6">
            <h2 class="h4">Rubros</h2>
            <EditForm Model="nuevoRubro" OnValidSubmit="CrearRubroAsync" class="d-flex gap-2 mb-3">
                <DataAnnotationsValidator />
                <InputText class="form-control" @bind-Value="nuevoRubro.Nombre" placeholder="Nuevo rubro..." />
                <button type="submit" class="btn btn-primary text-nowrap">+ Agregar</button>
            </EditForm>

            @if (rubros is not null)
            {
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th>Nombre</th><th class="text-end">Activo</th></tr></thead>
                    <tbody>
                        @foreach (var rubro in rubros)
                        {
                            <tr>
                                <td>
                                    <input class="form-control form-control-sm" value="@rubro.Nombre"
                                           @onchange='e => RenombrarRubroAsync(rubro, e.Value?.ToString())' />
                                </td>
                                <td class="text-end">
                                    <input type="checkbox" class="form-check-input" checked="@rubro.Activo"
                                           @onchange='e => ActivarRubroAsync(rubro, (bool)(e.Value ?? false))' />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="col-md-6">
            <h2 class="h4">Técnicas</h2>
            <EditForm Model="nuevaTecnica" OnValidSubmit="CrearTecnicaAsync" class="d-flex gap-2 mb-3">
                <DataAnnotationsValidator />
                <InputText class="form-control" @bind-Value="nuevaTecnica.Nombre" placeholder="Nueva técnica..." />
                <button type="submit" class="btn btn-primary text-nowrap">+ Agregar</button>
            </EditForm>

            @if (tecnicas is not null)
            {
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th>Nombre</th><th class="text-end">Activo</th></tr></thead>
                    <tbody>
                        @foreach (var tecnica in tecnicas)
                        {
                            <tr>
                                <td>
                                    <input class="form-control form-control-sm" value="@tecnica.Nombre"
                                           @onchange='e => RenombrarTecnicaAsync(tecnica, e.Value?.ToString())' />
                                </td>
                                <td class="text-end">
                                    <input type="checkbox" class="form-check-input" checked="@tecnica.Activo"
                                           @onchange='e => ActivarTecnicaAsync(tecnica, (bool)(e.Value ?? false))' />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private List<CatalogoItem>? rubros;
    private List<CatalogoItem>? tecnicas;
    private NombreInput nuevoRubro = new();
    private NombreInput nuevaTecnica = new();

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        rubros = await CatalogoRepository.ListarRubrosAdminAsync();
        tecnicas = await CatalogoRepository.ListarTecnicasAdminAsync();
    }

    private async Task CrearRubroAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevoRubro.Nombre)) return;
        await CatalogoRepository.CrearRubroAsync(nuevoRubro.Nombre.Trim());
        nuevoRubro = new();
        await CargarAsync();
    }

    private async Task CrearTecnicaAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevaTecnica.Nombre)) return;
        await CatalogoRepository.CrearTecnicaAsync(nuevaTecnica.Nombre.Trim());
        nuevaTecnica = new();
        await CargarAsync();
    }

    private async Task RenombrarRubroAsync(CatalogoItem rubro, string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return;
        await CatalogoRepository.ActualizarRubroAsync(rubro.Id, nombre.Trim(), rubro.Activo);
        await CargarAsync();
    }

    private async Task RenombrarTecnicaAsync(CatalogoItem tecnica, string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return;
        await CatalogoRepository.ActualizarTecnicaAsync(tecnica.Id, nombre.Trim(), tecnica.Activo);
        await CargarAsync();
    }

    private async Task ActivarRubroAsync(CatalogoItem rubro, bool activo)
    {
        await CatalogoRepository.ActualizarRubroAsync(rubro.Id, rubro.Nombre, activo);
        await CargarAsync();
    }

    private async Task ActivarTecnicaAsync(CatalogoItem tecnica, bool activo)
    {
        await CatalogoRepository.ActualizarTecnicaAsync(tecnica.Id, tecnica.Nombre, activo);
        await CargarAsync();
    }

    private sealed class NombreInput
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string Nombre { get; set; } = "";
    }
}
