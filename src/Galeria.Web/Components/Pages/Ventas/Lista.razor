@page "/ventas"
@attribute [Authorize]
@using Galeria.Application.Artistas
@using Galeria.Application.Ventas
@inject VentaService VentaService
@inject ArtistaService ArtistaService
@inject NavigationManager NavigationManager

<PageTitle>Ventas</PageTitle>
<HeadContent>
    <meta name="description" content="Listado de ventas registradas, filtrable por artista, moneda y fecha." />
</HeadContent>

<h1>Ventas</h1>

<div class="row mb-3 g-2">
    <div class="col-md-4">
        <input class="form-control" placeholder="Buscar por obra o artista..."
               @bind="texto" @bind:event="oninput" @bind:after='() => IrA("q", texto)' />
    </div>
    <div class="col-md-3">
        <select class="form-select" value="@(ArtistaId?.ToString() ?? "")" @onchange='e => IrA("artista", ParseIntOrNull(e.Value))'>
            <option value="">Todos los artistas</option>
            @if (artistas is not null)
            {
                @foreach (var artista in artistas)
                {
                    <option value="@artista.Id">@artista.NombreCompleto</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select" value="@(MonedaTexto ?? "")" @onchange='e => IrA("moneda", e.Value?.ToString())'>
            <option value="">Ambas monedas</option>
            <option value="Pesos">$ Pesos</option>
            <option value="USD">U$S Dólares</option>
        </select>
    </div>
    <div class="col-md-3 text-end">
        <a class="btn btn-outline-secondary" href="@EnlaceExportarCsv()" target="_blank">Exportar CSV</a>
        <a class="btn btn-primary" href="ventas/nueva">+ Nueva venta</a>
    </div>
</div>

@if (ventas is null)
{
    <p><em>Cargando...</em></p>
}
else if (ventas.Count == 0)
{
    <p>No hay ventas que coincidan con los filtros.</p>
}
else
{
    @if (ventas.Count >= Galeria.Application.Common.Listados.Tope)
    {
        <p class="text-body-secondary">Mostrando las primeras @Galeria.Application.Common.Listados.Tope ventas que coinciden — acotá con los filtros para ver el resto.</p>
    }
    <div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th role="button" @onclick="() => OrdenarPor(OrdenVenta.Fecha)">Fecha @Flecha(OrdenVenta.Fecha)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenVenta.Codigo)">Código @Flecha(OrdenVenta.Codigo)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenVenta.Titulo)">Nombre @Flecha(OrdenVenta.Titulo)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenVenta.Artista)">Artista @Flecha(OrdenVenta.Artista)</th>
                <th role="button" class="text-end" @onclick="() => OrdenarPor(OrdenVenta.Cantidad)">Cantidad @Flecha(OrdenVenta.Cantidad)</th>
                <th role="button" class="text-end" @onclick="() => OrdenarPor(OrdenVenta.Precio)">Precio @Flecha(OrdenVenta.Precio)</th>
                <th>Certificado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venta in ventas)
            {
                <tr>
                    <td>@venta.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@venta.CodigoObra</td>
                    <td>@venta.Titulo</td>
                    <td>@venta.ArtistaNombre</td>
                    <td class="text-end">@venta.Cantidad</td>
                    <td class="text-end">@Formato.Monto(venta.PrecioVenta, venta.Moneda)</td>
                    <td>
                        @if (venta.TieneCertificado)
                        {
                            <a href="certificados/emitir/@venta.Id">Ver certificado</a>
                        }
                        else
                        {
                            <a href="certificados/emitir/@venta.Id">Emitir certificado</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? TextoLibre { get; set; }
    [SupplyParameterFromQuery(Name = "artista")] public int? ArtistaId { get; set; }
    [SupplyParameterFromQuery(Name = "moneda")] public string? MonedaTexto { get; set; }
    [SupplyParameterFromQuery(Name = "orden")] public string? OrdenTexto { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? OrdenDescendente { get; set; }

    private Moneda? MonedaFiltro => Enum.TryParse<Moneda>(MonedaTexto, out var m) ? m : null;
    private OrdenVenta? Orden => Enum.TryParse<OrdenVenta>(OrdenTexto, out var o) ? o : null;
    private OrdenVenta OrdenActual => Orden ?? OrdenVenta.Fecha;
    private bool DescActual => OrdenDescendente ?? true;

    private List<VentaListItem>? ventas;
    private List<ArtistaOpcion>? artistas;
    private string? texto;

    protected override async Task OnInitializedAsync()
    {
        artistas = await ArtistaService.ListarParaSeleccionAsync();
        texto = TextoLibre;
    }

    protected override async Task OnParametersSetAsync()
    {
        texto = TextoLibre;
        var filtro = new VentaFiltro(TextoLibre, ArtistaId, MonedaFiltro, Orden: OrdenActual, OrdenDescendente: DescActual);
        // Tope de filas para no colgar el navegador con el histórico completo (~14.000). Red de
        // seguridad, no paginación real. El endpoint /ventas/exportar.csv no tiene este tope.
        ventas = (await VentaService.BuscarAsync(filtro))
            .Take(Galeria.Application.Common.Listados.Tope).ToList();
    }

    private void IrA(string clave, object? valor) =>
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> { [clave] = valor }), replace: true);

    private void OrdenarPor(OrdenVenta campo)
    {
        var descNuevo = OrdenActual == campo ? !DescActual : true;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["orden"] = campo.ToString(),
            ["desc"] = descNuevo.ToString().ToLowerInvariant()
        }), replace: true);
    }

    private string Flecha(OrdenVenta campo) => OrdenActual != campo ? "" : (DescActual ? " ▼" : " ▲");

    private static int? ParseIntOrNull(object? valor) => int.TryParse(valor?.ToString(), out var n) ? n : null;

    private string EnlaceExportarCsv() => "ventas/exportar.csv" + new Uri(NavigationManager.Uri).Query;
}
