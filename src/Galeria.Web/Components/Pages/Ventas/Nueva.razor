@page "/ventas/nueva"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Galeria.Application.Obras
@using Galeria.Application.Ventas
@inject VentaService VentaService
@inject ObraService ObraService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment WebHostEnvironment

<PageTitle>Nueva venta</PageTitle>
<HeadContent>
    <meta name="description" content="Registrar la venta de una obra: busca la pieza, confirmá cantidad y precio." />
</HeadContent>

<div class="page-form">
<h1>Nueva venta</h1>

@if (error is not null)
{
    <ul class="text-danger" role="alert"><li>@error</li></ul>
}

@if (obra is null)
{
    <div class="mb-3">
        <label class="form-label">Buscar obra por código, nombre o artista</label>
        <input class="form-control" @bind="texto" @bind:event="oninput" @bind:after="BuscarAsync" autofocus />
    </div>

    @if (resultados is not null)
    {
        @if (resultados.Count == 0)
        {
            <p class="mt-3">
                No se encontraron obras disponibles con ese criterio.
                <span class="text-body-secondary">Puede que el artista no tenga obras en existencia.</span>
            </p>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-striped mt-3">
                <thead>
                    <tr><th>Código</th><th>Nombre</th><th>Artista</th><th class="text-end">Stock</th><th class="text-end">Precio</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in resultados)
                    {
                        <tr style="cursor:pointer" @onclick="() => SeleccionarAsync(item.Id)">
                            <td>@item.CodigoVisible</td>
                            <td>@item.Titulo</td>
                            <td>@item.ArtistaNombre</td>
                            <td class="text-end">@item.Existencia</td>
                            <td class="text-end">@Formato.Monto(item.PrecioVenta, item.Moneda)</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
}
else
{
    <div>
        <h2 class="h5">@obra.CodigoVisible — @obra.Titulo</h2>
        <p class="text-body-secondary mb-1">Artista: @obra.ArtistaNombre</p>
        <p class="mb-3">Quedan en stock: <strong>@obra.Existencia</strong></p>

        @if (obra.Existencia == 1)
        {
            <div class="alert alert-warning fw-bold">¡ÚLTIMA PIEZA!</div>
        }

        <EditForm Model="Input" OnValidSubmit="ConfirmarAsync" FormName="nueva-venta" data-enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Cantidad</label>
                    <InputNumber class="form-control" @bind-Value="Input.Cantidad" ParsingErrorMessage="Ese valor no es un número válido." />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha</label>
                    <InputDate class="form-control" @bind-Value="Input.Fecha" ParsingErrorMessage="Esa fecha no es válida." />
                </div>
                <div class="col-md-3 mb-3 form-check pt-4 mt-2">
                    <InputCheckbox class="form-check-input" id="exenta" @bind-Value="Input.ExentaIVA" />
                    <label class="form-check-label" for="exenta">Exenta de IVA</label>
                </div>
                <div class="col-md-3 mb-3">
                    <button type="button" class="btn btn-link p-0" @onclick="() => mostrarCosto = !mostrarCosto">
                        @(mostrarCosto ? "🙈 Ocultar costo" : "👁 Ver costo")
                    </button>
                    @if (mostrarCosto)
                    {
                        <div>@Formato.Monto(obra.Costo, obra.Moneda)</div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Precio de venta (@Formato.Simbolo(obra.Moneda))</label>
                <InputNumber class="form-control fw-bold fs-4" @bind-Value="Input.PrecioVenta" ParsingErrorMessage="Ese valor no es un número válido." />
                <div class="form-text">Precargado con el precio calculado — se puede negociar con el cliente.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Observaciones</label>
                <InputTextArea class="form-control" @bind-Value="Input.Observaciones" rows="2" />
            </div>

            @if (obra.ImagenUrl is null)
            {
                <div class="mb-3">
                    <label class="form-label">Foto de la obra (opcional — hace falta para el certificado de autenticidad)</label>
                    <InputFile class="form-control" OnChange="SeleccionarImagen" accept=".jpg,.jpeg,.png,.webp" />
                    @if (imagenError is not null)
                    {
                        <div class="text-danger">@imagenError</div>
                    }
                    @if (imagenSeleccionada is not null && imagenError is null)
                    {
                        <div class="form-text">@imagenSeleccionada.Name (@((imagenSeleccionada.Size / 1024.0).ToString("N0")) KB)</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : "Confirmar venta")</button>
            <button type="button" class="btn btn-outline-danger" @onclick="Cancelar">Cancelar</button>
        </EditForm>
    </div>
}
</div>

<ConfirmModal @ref="confirmModal" />

@code {
    private string? texto;
    private List<ObraParaOperacion>? resultados;
    private ObraParaOperacion? obra;
    private bool mostrarCosto;
    private string? error;
    private int guardandoFlag;
    private bool guardando => guardandoFlag != 0;
    private InputModel Input { get; set; } = new();
    private ConfirmModal confirmModal = default!;
    private IBrowserFile? imagenSeleccionada;
    private string? imagenError;

    private void SeleccionarImagen(InputFileChangeEventArgs e)
    {
        imagenSeleccionada = e.File;
        ImagenObraHelper.EsValida(e.File, out imagenError);
    }

    private async Task BuscarAsync() => resultados = await VentaService.BuscarObrasDisponiblesAsync(texto);

    private async Task SeleccionarAsync(int obraId)
    {
        obra = await VentaService.ObtenerObraParaVentaAsync(obraId);
        if (obra is null) return;

        Input = new InputModel
        {
            Cantidad = 1,
            Fecha = DateTime.Now,
            ExentaIVA = !obra.TieneIVA,
            PrecioVenta = obra.PrecioVenta
        };
    }

    private void Cancelar()
    {
        obra = null;
        error = null;
    }

    private void ConfirmarAsync()
    {
        if (obra is null) return;
        error = null;

        confirmModal.Mostrar(
            "Confirmar venta",
            $"¿Confirmás la venta de \"{obra.Titulo}\" ({obra.CodigoVisible}) por {Formato.Monto(Input.PrecioVenta, obra.Moneda)}?",
            RegistrarAsync,
            "Confirmar venta");
    }

    private async Task RegistrarAsync()
    {
        if (obra is null) return;
        if (Interlocked.CompareExchange(ref guardandoFlag, 1, 0) != 0) return;

        try
        {
            var request = new RegistrarVentaRequest(
                obra.Id,
                DateOnly.FromDateTime(Input.Fecha),
                Input.Cantidad,
                obra.Moneda,
                Input.PrecioVenta,
                Input.ExentaIVA,
                Input.Observaciones);

            var ventaId = await VentaService.RegistrarAsync(request);

            if (imagenSeleccionada is not null && imagenError is null)
            {
                var ruta = await ImagenObraHelper.GuardarAsync(imagenSeleccionada, obra.Id, WebHostEnvironment.WebRootPath);
                await ObraService.ActualizarImagenAsync(obra.Id, ruta);
            }

            NavigationManager.NavigateTo($"certificados/emitir/{ventaId}");
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        finally
        {
            guardandoFlag = 0;
            StateHasChanged();
        }
    }

    private sealed class InputModel
    {
        [Range(1, 9999, ErrorMessage = "La cantidad tiene que ser al menos 1.")]
        public int Cantidad { get; set; } = 1;

        public DateTime Fecha { get; set; } = DateTime.Now;

        public bool ExentaIVA { get; set; }

        [Range(typeof(decimal), "0.01", "999999999", ErrorMessage = "El precio de venta tiene que ser mayor a 0.", ParseLimitsInInvariantCulture = true)]
        public decimal PrecioVenta { get; set; }

        [MaxLength(1000)]
        public string? Observaciones { get; set; }
    }
}
