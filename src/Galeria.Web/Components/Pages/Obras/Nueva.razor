@page "/obras/nueva"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Galeria.Application.Artistas
@using Galeria.Application.Catalogos
@using Galeria.Application.Obras
@using Galeria.Domain.Entities
@inject ObraService ObraService
@inject ArtistaService ArtistaService
@inject ICatalogoRepository CatalogoRepository
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment WebHostEnvironment

<PageTitle>Nueva obra</PageTitle>
<HeadContent>
    <meta name="description" content="Alta de una nueva obra en el stock de la galería." />
</HeadContent>

<div class="page-form">
<h1>Nueva obra</h1>

@if (mensaje is not null)
{
    <div class="alert alert-success alert-dismissible">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
    </div>
}

@if (parametros is null || artistas is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <EditForm Model="Input" OnValidSubmit="GuardarAsync" FormName="obra-nueva" data-enhance="false">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="row">
            <div class="col-md-8 mb-3">
                <label class="form-label">Artista</label>
                <div class="input-group">
                    <InputSelect TValue="int?" class="form-select" Value="Input.ArtistaId" ValueChanged="OnArtistaIdChanged" ValueExpression="() => Input.ArtistaId">
                        <option value="">Seleccioná un artista...</option>
                        @foreach (var artista in artistas)
                        {
                            <option value="@artista.Id">@artista.Codigo.ToString("D3") — @artista.NombreCompleto</option>
                        }
                    </InputSelect>
                    <button type="button" class="btn btn-outline-secondary" @onclick="RecargarArtistasAsync" title="Releer la lista de artistas">↻</button>
                </div>
<div class="form-text">
                    ¿El artista es nuevo? <a href="artistas/nuevo" target="_blank">Crealo acá</a> y después apretá ↻.
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Nombre de la obra</label>
            <InputText class="form-control" Value="@Input.Titulo" ValueChanged="OnTituloChanged" ValueExpression="() => Input.Titulo" />
</div>

        @if (coincidencia is not null)
        {
            <div class="alert alert-warning">
                <p>
                    Este artista ya tiene una obra llamada <strong>@coincidencia.Titulo</strong>
                    (código @coincidencia.CodigoVisible, stock actual @coincidencia.Existencia).
                </p>
                @if (Input.Costo > 0 && Input.Costo != coincidencia.Costo)
                {
                    <p class="mb-2">
                        ⚠️ El costo que ingresaste (@Formato.Monto(Input.Costo, Input.Moneda)) es distinto al de esa obra
                        (@Formato.Monto(coincidencia.Costo, Input.Moneda)) — podría ser un cambio de precio encubierto.
                    </p>
                }
                <div class="d-flex align-items-end gap-2">
                    <div>
                        <label class="form-label mb-0">Cantidad a agregar</label>
                        <InputNumber class="form-control" @bind-Value="cantidadAAgregar" min="1" style="width: 8rem;" />
                    </div>
                    <button type="button" class="btn btn-warning" @onclick="AgregarExistenciaAsync">Agregar existencia a esa obra</button>
                </div>
                @if (errorExistencia is not null)
                {
                    <div class="text-danger mt-2">@errorExistencia</div>
                }
                <p class="mt-2 mb-0">
                    <small>¿Es en realidad una obra distinta? Completá el resto del formulario y guardá normalmente.</small>
                </p>
            </div>
        }

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Rubro</label>
                <InputSelect class="form-select" @bind-Value="Input.RubroId">
                    <option value="">Sin especificar</option>
                    @foreach (var rubro in rubros)
                    {
                        <option value="@rubro.Id">@rubro.Nombre</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Técnica</label>
                <InputSelect class="form-select" @bind-Value="Input.TecnicaId">
                    <option value="">Sin especificar</option>
                    @foreach (var tecnica in tecnicas)
                    {
                        <option value="@tecnica.Id">@tecnica.Nombre</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Alto (cm)</label>
                <InputNumber class="form-control" @bind-Value="Input.AltoCm" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Ancho (cm)</label>
                <InputNumber class="form-control" @bind-Value="Input.AnchoCm" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Largo (cm)</label>
                <InputNumber class="form-control" @bind-Value="Input.LargoCm" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Existencia</label>
                <InputNumber class="form-control" @bind-Value="Input.Existencia" />
<div class="form-text">Piezas iguales bajo un mismo código (ej. 10 caravanas idénticas → existencia 10).</div>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Moneda</label>
                <InputSelect TValue="Moneda" class="form-select" Value="Input.Moneda" ValueChanged="OnMonedaChanged" ValueExpression="() => Input.Moneda">
                    <option value="@Moneda.Pesos">Pesos ($)</option>
                    <option value="@Moneda.USD">Dólares (U$S)</option>
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3 form-check pt-4 mt-2">
                <InputCheckbox TValue="bool" class="form-check-input" id="tieneIva" Value="Input.TieneIVA" ValueChanged="OnTieneIvaChanged" ValueExpression="() => Input.TieneIVA" />
                <label class="form-check-label" for="tieneIva">Tiene IVA</label>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Serie (cantidad de piezas)</label>
                <InputNumber class="form-control" @bind-Value="Input.CantidadEnSerie" />
                <div class="form-text">
                    Piezas distintas con el mismo formulario (ej. 10 caravanas distintas → 10, cada una con su propio código).
                </div>
            </div>
            @if (Input.CantidadEnSerie > 1)
            {
                <div class="col-md-8 mb-3">
                    <label class="form-label">Nombre de la serie</label>
                    <InputText class="form-control" @bind-Value="Input.NombreSerie" />
</div>
            }
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Costo (lo que cobra el artista)</label>
                <InputNumber TValue="decimal" class="form-control" Value="Input.Costo" ValueChanged="OnCostoChanged" ValueExpression="() => Input.Costo" />
</div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Utilidad (%)</label>
                <InputNumber TValue="decimal" class="form-control" Value="Input.Utilidad" ValueChanged="OnUtilidadChanged" ValueExpression="() => Input.Utilidad" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Precio de venta</label>
                <InputNumber TValue="decimal" class="form-control fw-bold" Value="Input.PrecioVenta" ValueChanged="OnPrecioVentaChanged" ValueExpression="() => Input.PrecioVenta" />
                <div class="form-text">Calculado automático — se puede ajustar a mano.</div>
            </div>
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" id="pagoContado" @bind-Value="Input.PagoContado" />
            <label class="form-check-label" for="pagoContado">
                Pago contado (ya se le pagó al artista al ingresar la pieza)
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label">Observaciones</label>
            <InputTextArea class="form-control" @bind-Value="Input.Observaciones" rows="2" />
        </div>

        @if (Input.CantidadEnSerie == 1)
        {
            <div class="mb-3">
                <label class="form-label">Imagen (opcional — también se puede subir más tarde desde la ficha)</label>
                <InputFile @key="formResetKey" class="form-control" OnChange="SeleccionarImagen" accept=".jpg,.jpeg,.png,.webp" />
                @if (imagenError is not null)
                {
                    <div class="text-danger">@imagenError</div>
                }
                @if (imagenSeleccionada is not null && imagenError is null)
                {
                    <div class="form-text">@imagenSeleccionada.Name (@((imagenSeleccionada.Size / 1024.0).ToString("N0")) KB)</div>
                }
            </div>
        }

        <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : "Guardar")</button>
        <a href="obras" class="btn btn-link text-danger">Cancelar</a>
    </EditForm>
}
</div>

@code {
    private InputModel Input { get; set; } = new();

    private List<ArtistaOpcion>? artistas;
    private List<OpcionCatalogo> rubros = [];
    private List<OpcionCatalogo> tecnicas = [];
    private ParametrosCalculoPrecio? parametros;
    private ObraCoincidente? coincidencia;
    private int cantidadAAgregar = 1;
    private string? errorExistencia;
    private string? mensaje;
    private int formResetKey;
    private bool precioEditadoManualmente;
    private IBrowserFile? imagenSeleccionada;
    private string? imagenError;
    private int guardandoFlag;
    private bool guardando => guardandoFlag != 0;

    protected override async Task OnInitializedAsync()
    {
        artistas = await ArtistaService.ListarParaSeleccionAsync();
        rubros = await CatalogoRepository.ListarRubrosAsync();
        tecnicas = await CatalogoRepository.ListarTecnicasAsync();
        parametros = await ObraService.ObtenerParametrosCalculoAsync();
        Input.Utilidad = parametros.UtilidadDefault;
        RecalcularPrecio();
    }

    private async Task RecargarArtistasAsync()
    {
        artistas = await ArtistaService.ListarParaSeleccionAsync();
    }

    private async Task VerificarCoincidenciaAsync()
    {
        coincidencia = Input.ArtistaId is null
            ? null
            : await ObraService.BuscarCoincidenciaAsync(Input.ArtistaId.Value, Input.Titulo);
    }

    private async Task OnArtistaIdChanged(int? valor)
    {
        Input.ArtistaId = valor;
        await VerificarCoincidenciaAsync();
    }

    private async Task OnTituloChanged(string valor)
    {
        Input.Titulo = valor;
        await VerificarCoincidenciaAsync();
    }

    private void RecalcularPrecio()
    {
        if (parametros is null || precioEditadoManualmente)
        {
            return;
        }

        var redondeo = parametros.RedondeoPara(Input.Moneda);
        Input.PrecioVenta = Obra.CalcularPrecioVenta(Input.Costo, Input.Utilidad, Input.TieneIVA, parametros.IvaPorcentaje, redondeo);
        StateHasChanged();
    }

    private void MarcarPrecioEditado() => precioEditadoManualmente = true;

    private void OnMonedaChanged(Moneda valor)
    {
        Input.Moneda = valor;
        RecalcularPrecio();
    }

    private void OnTieneIvaChanged(bool valor)
    {
        Input.TieneIVA = valor;
        RecalcularPrecio();
    }

    private void OnCostoChanged(decimal valor)
    {
        Input.Costo = valor;
        RecalcularPrecio();
    }

    private void OnUtilidadChanged(decimal valor)
    {
        Input.Utilidad = valor;
        RecalcularPrecio();
    }

    private void OnPrecioVentaChanged(decimal valor)
    {
        Input.PrecioVenta = valor;
        MarcarPrecioEditado();
    }

    private void SeleccionarImagen(InputFileChangeEventArgs e)
    {
        imagenSeleccionada = e.File;
        ImagenObraHelper.EsValida(e.File, out imagenError);
    }

    private async Task AgregarExistenciaAsync()
    {
        if (coincidencia is null)
        {
            return;
        }

        try
        {
            await ObraService.AgregarExistenciaAsync(coincidencia.Id, cantidadAAgregar);
            NavigationManager.NavigateTo("obras");
        }
        catch (InvalidOperationException ex)
        {
            errorExistencia = ex.Message;
        }
    }

    private async Task GuardarAsync()
    {
        if (Interlocked.CompareExchange(ref guardandoFlag, 1, 0) != 0) return;

        try
        {
            var request = new CrearObraRequest(
                Input.ArtistaId!.Value,
                Input.Titulo.Trim(),
                Input.RubroId,
                Input.TecnicaId,
                Input.AltoCm,
                Input.AnchoCm,
                Input.LargoCm,
                Input.Existencia,
                Input.Moneda,
                Input.Costo,
                Input.Utilidad,
                Input.TieneIVA,
                Input.PrecioVenta,
                Input.PagoContado,
                Input.Observaciones);

            if (Input.CantidadEnSerie > 1)
            {
                await ObraService.CrearSerieAsync(request, Input.CantidadEnSerie, Input.NombreSerie ?? Input.Titulo);
                mensaje = $"Serie \"{request.Titulo}\" agregada ({Input.CantidadEnSerie} piezas). Podés seguir cargando obras.";
            }
            else
            {
                var obraId = await ObraService.CrearAsync(request);

                if (imagenSeleccionada is not null && imagenError is null)
                {
                    var ruta = await ImagenObraHelper.GuardarAsync(imagenSeleccionada, obraId, WebHostEnvironment.WebRootPath);
                    await ObraService.ActualizarImagenAsync(obraId, ruta);
                }

                mensaje = $"\"{request.Titulo}\" agregada. Podés seguir cargando obras.";
            }

            var artistaIdAnterior = Input.ArtistaId;
            Input = new InputModel { ArtistaId = artistaIdAnterior, Utilidad = parametros!.UtilidadDefault };
            coincidencia = null;
            imagenSeleccionada = null;
            imagenError = null;
            precioEditadoManualmente = false;
            formResetKey++;
            RecalcularPrecio();
        }
        finally
        {
            guardandoFlag = 0;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Elegí un artista.")]
        public int? ArtistaId { get; set; }

        [Required(ErrorMessage = "El nombre de la obra es obligatorio.")]
        [MaxLength(200)]
        public string Titulo { get; set; } = "";

        public int? RubroId { get; set; }
        public int? TecnicaId { get; set; }

        public decimal? AltoCm { get; set; }
        public decimal? AnchoCm { get; set; }
        public decimal? LargoCm { get; set; }

        [Range(1, 9999, ErrorMessage = "La existencia tiene que ser al menos 1.")]
        public int Existencia { get; set; } = 1;

        [Range(1, 999, ErrorMessage = "La serie tiene que ser de al menos 1 pieza.")]
        public int CantidadEnSerie { get; set; } = 1;

        [MaxLength(150)]
        public string? NombreSerie { get; set; }

        public Moneda Moneda { get; set; } = Moneda.Pesos;

        [Range(typeof(decimal), "0.01", "999999999", ErrorMessage = "El costo tiene que ser mayor a 0.", ParseLimitsInInvariantCulture = true)]
        public decimal Costo { get; set; }

        [Range(typeof(decimal), "0", "1000", ErrorMessage = "La utilidad no puede ser negativa.", ParseLimitsInInvariantCulture = true)]
        public decimal Utilidad { get; set; } = 50;

        public bool TieneIVA { get; set; }

        [Range(typeof(decimal), "0", "999999999", ErrorMessage = "El precio de venta no puede ser negativo ni superar 999.999.999.", ParseLimitsInInvariantCulture = true)]
        public decimal PrecioVenta { get; set; }

        public bool PagoContado { get; set; }

        [MaxLength(2000)]
        public string? Observaciones { get; set; }
    }
}
