@page "/obras/{Id:int}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Galeria.Application.Auditorias
@using Galeria.Application.Catalogos
@using Galeria.Application.Obras
@using Galeria.Domain.Entities
@inject ObraService ObraService
@inject ICatalogoRepository CatalogoRepository
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment WebHostEnvironment

<PageTitle>@(ficha is null ? "Obra" : ficha.Titulo)</PageTitle>
<HeadContent>
    <meta name="description" content="Ficha de la obra: datos, precio y estado." />
</HeadContent>

@if (cargando)
{
    <p><em>Cargando...</em></p>
}
else if (ficha is null)
{
    <h1>Obra no encontrada</h1>
    <a href="obras" class="btn btn-link">Volver a Obras</a>
}
else
{
    <div class="page-form">
    <h1>@ficha.CodigoVisible — @ficha.Titulo</h1>

    <dl class="row mb-4">
        <dt class="col-sm-2">Artista</dt>
        <dd class="col-sm-4">@ficha.ArtistaNombre</dd>
        <dt class="col-sm-2">Moneda</dt>
        <dd class="col-sm-4">@Formato.Simbolo(ficha.Moneda)</dd>
        <dt class="col-sm-2">Existencia</dt>
        <dd class="col-sm-4">@ficha.Existencia</dd>
        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-4"><span class="badge bg-secondary">@Formato.Estado(ficha.Estado)</span></dd>
        <dt class="col-sm-2">Fecha de ingreso</dt>
        <dd class="col-sm-4">@ficha.FechaIngreso.ToString("dd/MM/yyyy")</dd>
        @if (ficha.SerieNombre is not null)
        {
            <dt class="col-sm-2">Serie</dt>
            <dd class="col-sm-4">Pieza @ficha.SeriePosicion de @ficha.SerieTotal · @ficha.SerieNombre</dd>
        }
    </dl>

    <div class="row mb-4">
        <div class="col-md-8">
            @if (ficha.ImagenUrl is not null)
            {
                <img src="@ficha.ImagenUrl" alt="@ficha.Titulo" class="img-thumbnail mb-2" style="max-height:220px" />
                <div>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="QuitarImagenAsync">Quitar imagen</button>
                </div>
            }
            else
            {
                <InputFile OnChange="SubirImagenAsync" accept=".jpg,.jpeg,.png,.webp" />
                @if (imagenError is not null)
                {
                    <div class="text-danger">@imagenError</div>
                }
            }
        </div>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(pestania == "datos" ? "active" : "")" @onclick='() => IrA("datos")'>Datos</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(pestania == "precios" ? "active" : "")" @onclick='() => IrA("precios")'>Historial de precios</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(pestania == "movimientos" ? "active" : "")" @onclick='() => IrA("movimientos")'>Historial de movimientos</button>
        </li>
    </ul>

    @if (pestania == "precios")
    {
        @if (historialPrecios is null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (historialPrecios.Count == 0)
        {
            <p>El precio no cambió desde que se cargó la obra.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>Fecha</th><th>Usuario</th><th class="text-end">Precio anterior</th><th class="text-end">Precio nuevo</th></tr></thead>
                <tbody>
                    @foreach (var cambio in historialPrecios)
                    {
                        <tr>
                            <td>@cambio.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@cambio.NombreUsuario</td>
                            <td class="text-end">@Formato.Monto(decimal.Parse(cambio.ValorAnterior ?? "0"), ficha.Moneda)</td>
                            <td class="text-end">@Formato.Monto(decimal.Parse(cambio.ValorNuevo ?? "0"), ficha.Moneda)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (pestania == "movimientos")
    {
        @if (movimientos is null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (movimientos.Count == 0)
        {
            <p>Todavía no hay movimientos de stock registrados para esta obra.</p>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead><tr><th>Fecha</th><th>Tipo</th><th class="text-end">Cantidad</th></tr></thead>
                <tbody>
                    @foreach (var movimiento in movimientos)
                    {
                        <tr>
                            <td>@movimiento.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@TipoMovimientoTexto(movimiento.Tipo)</td>
                            <td class="text-end">@(movimiento.Cantidad > 0 ? "+" : "")@movimiento.Cantidad</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else
    {
    <EditForm Model="Input" OnValidSubmit="GuardarAsync" FormName="obra-ficha" data-enhance="false">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="mb-3">
            <label class="form-label">Nombre de la obra</label>
            <InputText class="form-control" @bind-Value="Input.Titulo" />
</div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Rubro</label>
                <InputSelect class="form-select" @bind-Value="Input.RubroId">
                    <option value="">Sin especificar</option>
                    @foreach (var rubro in rubros)
                    {
                        <option value="@rubro.Id">@rubro.Nombre</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Técnica</label>
                <InputSelect class="form-select" @bind-Value="Input.TecnicaId">
                    <option value="">Sin especificar</option>
                    @foreach (var tecnica in tecnicas)
                    {
                        <option value="@tecnica.Id">@tecnica.Nombre</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Alto (cm)</label>
                <InputNumber class="form-control" @bind-Value="Input.AltoCm" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Ancho (cm)</label>
                <InputNumber class="form-control" @bind-Value="Input.AnchoCm" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Largo (cm)</label>
                <InputNumber class="form-control" @bind-Value="Input.LargoCm" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3 form-check pt-4 mt-2">
                <InputCheckbox TValue="bool" class="form-check-input" id="tieneIva" Value="Input.TieneIVA" ValueChanged="OnTieneIvaChanged" ValueExpression="() => Input.TieneIVA" />
                <label class="form-check-label" for="tieneIva">Tiene IVA</label>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Costo (lo que cobra el artista)</label>
                <InputNumber TValue="decimal" class="form-control" Value="Input.Costo" ValueChanged="OnCostoChanged" ValueExpression="() => Input.Costo" />
</div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Utilidad (%)</label>
                <InputNumber TValue="decimal" class="form-control" Value="Input.Utilidad" ValueChanged="OnUtilidadChanged" ValueExpression="() => Input.Utilidad" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Precio de venta</label>
                <InputNumber TValue="decimal" class="form-control fw-bold" Value="Input.PrecioVenta" ValueChanged="OnPrecioVentaChanged" ValueExpression="() => Input.PrecioVenta" />
                <div class="form-text">Calculado automático — se puede ajustar a mano.</div>
            </div>
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox class="form-check-input" id="pagoContado" @bind-Value="Input.PagoContado" />
            <label class="form-check-label" for="pagoContado">
                Pago contado (ya se le pagó al artista al ingresar la pieza)
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label">Observaciones</label>
            <InputTextArea class="form-control" @bind-Value="Input.Observaciones" rows="2" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : "Guardar")</button>
        <a href="obras" class="btn btn-link text-danger">Cancelar</a>
    </EditForm>
    }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InputModel Input { get; set; } = new();

    private bool cargando = true;
    private ObraFicha? ficha;
    private List<OpcionCatalogo> rubros = [];
    private List<OpcionCatalogo> tecnicas = [];
    private ParametrosCalculoPrecio? parametros;
    private bool precioEditadoManualmente;

    private string pestania = "datos";
    private List<AuditoriaListItem>? historialPrecios;
    private List<MovimientoItem>? movimientos;
    private string? imagenError;
    private int guardandoFlag;
    private bool guardando => guardandoFlag != 0;

    protected override async Task OnInitializedAsync()
    {
        rubros = await CatalogoRepository.ListarRubrosAsync();
        tecnicas = await CatalogoRepository.ListarTecnicasAsync();
        parametros = await ObraService.ObtenerParametrosCalculoAsync();
        ficha = await ObraService.ObtenerFichaAsync(Id);

        if (ficha is not null)
        {
            Input = new InputModel
            {
                Titulo = ficha.Titulo,
                RubroId = ficha.RubroId,
                TecnicaId = ficha.TecnicaId,
                AltoCm = ficha.AltoCm,
                AnchoCm = ficha.AnchoCm,
                LargoCm = ficha.LargoCm,
                Costo = ficha.Costo,
                Utilidad = ficha.Utilidad,
                TieneIVA = ficha.TieneIVA,
                PrecioVenta = ficha.PrecioVenta,
                PagoContado = ficha.PagoContado,
                Observaciones = ficha.Observaciones
            };
        }

        cargando = false;
    }

    // precioEditadoManualmente arranca en false a propósito: al entrar no se llama a
    // RecalcularPrecio (Input ya se inicializó con ficha.PrecioVenta arriba), así que el precio
    // guardado no se pisa solo por abrir la ficha. Recién se recalcula si tocan Costo/Utilidad/IVA
    // — y si el usuario edita Precio de venta a mano, MarcarPrecioEditado corta el auto-cálculo.
    private void RecalcularPrecio()
    {
        if (parametros is null || ficha is null || precioEditadoManualmente)
        {
            return;
        }

        var redondeo = parametros.RedondeoPara(ficha.Moneda);
        Input.PrecioVenta = Obra.CalcularPrecioVenta(Input.Costo, Input.Utilidad, Input.TieneIVA, parametros.IvaPorcentaje, redondeo);
        StateHasChanged();
    }

    private void MarcarPrecioEditado() => precioEditadoManualmente = true;

    private void OnTieneIvaChanged(bool valor)
    {
        Input.TieneIVA = valor;
        RecalcularPrecio();
    }

    private void OnCostoChanged(decimal valor)
    {
        Input.Costo = valor;
        RecalcularPrecio();
    }

    private void OnUtilidadChanged(decimal valor)
    {
        Input.Utilidad = valor;
        RecalcularPrecio();
    }

    private void OnPrecioVentaChanged(decimal valor)
    {
        Input.PrecioVenta = valor;
        MarcarPrecioEditado();
    }

    // Sube o quita la imagen al toque, sin pasar por el botón "Guardar" del resto de la ficha —
    // es una acción independiente del formulario de datos (requerimiento 3.2, "o más tarde").
    private async Task SubirImagenAsync(InputFileChangeEventArgs e)
    {
        imagenError = null;

        if (!ImagenObraHelper.EsValida(e.File, out imagenError))
        {
            return;
        }

        var ruta = await ImagenObraHelper.GuardarAsync(e.File, Id, WebHostEnvironment.WebRootPath);
        await ObraService.ActualizarImagenAsync(Id, ruta);
        ficha = ficha! with { ImagenUrl = ruta };
    }

    private async Task QuitarImagenAsync()
    {
        await ObraService.ActualizarImagenAsync(Id, null);
        ImagenObraHelper.Eliminar(Id, WebHostEnvironment.WebRootPath);
        ficha = ficha! with { ImagenUrl = null };
    }

    // Cada pestaña carga sus datos recién la primera vez que se abre — evita dos consultas de
    // más (precios/movimientos) en el caso más común, que es solo mirar/editar los Datos.
    private async Task IrA(string pestaniaNueva)
    {
        pestania = pestaniaNueva;

        if (pestaniaNueva == "precios" && historialPrecios is null)
        {
            historialPrecios = await ObraService.ObtenerHistorialPreciosAsync(Id);
        }
        else if (pestaniaNueva == "movimientos" && movimientos is null)
        {
            movimientos = await ObraService.ObtenerMovimientosAsync(Id);
        }
    }

    private static string TipoMovimientoTexto(TipoMovimiento tipo) => tipo switch
    {
        TipoMovimiento.Inicial => "Carga inicial",
        TipoMovimiento.Ingreso => "Ingreso",
        TipoMovimiento.Venta => "Venta",
        TipoMovimiento.Ajuste => "Ajuste",
        TipoMovimiento.Devolucion => "Devolución",
        TipoMovimiento.RetiroTemporal => "Retiro temporal",
        TipoMovimiento.RetiroDefinitivo => "Retiro definitivo",
        TipoMovimiento.Alquiler => "Alquiler",
        TipoMovimiento.DevolucionAlquiler => "Devolución de alquiler",
        TipoMovimiento.DevolucionTemporal => "Devolución de retiro temporal",
        _ => tipo.ToString()
    };

    private async Task GuardarAsync()
    {
        if (Interlocked.CompareExchange(ref guardandoFlag, 1, 0) != 0) return;

        try
        {
            var request = new ActualizarObraRequest(
                Id,
                Input.Titulo.Trim(),
                Input.RubroId,
                Input.TecnicaId,
                Input.AltoCm,
                Input.AnchoCm,
                Input.LargoCm,
                Input.Costo,
                Input.Utilidad,
                Input.TieneIVA,
                Input.PrecioVenta,
                Input.PagoContado,
                Input.Observaciones);

            await ObraService.ActualizarAsync(request);

            NavigationManager.NavigateTo("obras");
        }
        finally
        {
            guardandoFlag = 0;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El nombre de la obra es obligatorio.")]
        [MaxLength(200)]
        public string Titulo { get; set; } = "";

        public int? RubroId { get; set; }
        public int? TecnicaId { get; set; }

        public decimal? AltoCm { get; set; }
        public decimal? AnchoCm { get; set; }
        public decimal? LargoCm { get; set; }

        [Range(0.01, 999999999, ErrorMessage = "El costo tiene que ser mayor a 0.")]
        public decimal Costo { get; set; }

        [Range(0, 1000, ErrorMessage = "La utilidad no puede ser negativa.")]
        public decimal Utilidad { get; set; }

        public bool TieneIVA { get; set; }

        [Range(0, 999999999)]
        public decimal PrecioVenta { get; set; }

        public bool PagoContado { get; set; }

        [MaxLength(2000)]
        public string? Observaciones { get; set; }
    }
}
