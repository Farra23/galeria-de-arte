@page "/"
@attribute [Authorize]
@using Galeria.Application.Resumen
@using Galeria.Domain.Enums
@inject ResumenService ResumenService
@inject NavigationManager NavigationManager

<PageTitle>Resumen</PageTitle>
<HeadContent>
    <meta name="description" content="Panel de entrada: ventas del mes, plata adeudada a artistas y avisos operativos." />
</HeadContent>

<div class="page-wide">
<h1 class="h3 mb-2">Resumen</h1>

@if (resumen is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="row g-3 mb-2">
        <div class="col-md-6">
            <div class="card h-100 text-center" style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo($"ventas?desde={primerDiaDelMes}")'>
                <div class="card-body py-2">
                    <div class="text-body-secondary">Ventas del mes</div>
                    <div class="fs-4 fw-bold">@resumen.VentasDelMes.Cantidad</div>
                    <div>@Formato.Monto(resumen.VentasDelMes.TotalPesos, Moneda.Pesos) — @Formato.Monto(resumen.VentasDelMes.TotalDolares, Moneda.USD)</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 text-center" style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("artistas")'>
                <div class="card-body py-2">
                    <div class="text-body-secondary">Adeudado a artistas</div>
                    <div class="fs-5 fw-bold">@Formato.Monto(resumen.TotalAdeudadoPesos, Moneda.Pesos)</div>
                    <div class="fs-5 fw-bold">@Formato.Monto(resumen.TotalAdeudadoDolares, Moneda.USD)</div>
                </div>
            </div>
        </div>
    </div>

    @* Retiros vencidos y alquileres sin fecha de recupero NO tienen su propia tarjeta acá — antes
       la tenían Y aparecían de nuevo en Pendientes, duplicado. "Pendientes" abajo es la única
       fuente de esos dos avisos (y de todo lo demás), para no repetir el mismo dato dos veces.
       <details>/<summary> nativo en vez de un componente de acordeón: no hace falta JS ni
       Bootstrap Collapse para algo tan simple, y arranca abierto para no esconder avisos. *@
    @if (!HayPendientes(resumen))
    {
        <p class="text-body-secondary mb-2">Pendientes: no hay — todo al día.</p>
    }
    else
    {
        <details class="pendientes-panel mb-2" open>
            <summary>Pendientes <span class="badge">@TotalPendientes(resumen)</span></summary>
            <ul class="list-group list-group-flush">
                @if (resumen.Avisos.ObrasSinTecnica > 0)
                {
                    <li class="list-group-item" style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("obras")'>
                        @resumen.Avisos.ObrasSinTecnica obra(s) sin técnica cargada.
                    </li>
                }
                @if (resumen.Avisos.ObrasSinRubro > 0)
                {
                    <li class="list-group-item" style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("obras")'>
                        @resumen.Avisos.ObrasSinRubro obra(s) sin rubro cargado.
                    </li>
                }
                @if (resumen.Avisos.RetirosVencidos > 0)
                {
                    <li class="list-group-item" style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("retiros")'>
                        @resumen.Avisos.RetirosVencidos retiro(s) vencido(s) sin devolver.
                    </li>
                }
                @if (resumen.Avisos.AlquileresSinFechaRecupero > 0)
                {
                    <li class="list-group-item" style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("alquileres")'>
                        @resumen.Avisos.AlquileresSinFechaRecupero alquiler(es) sin fecha de recupero.
                    </li>
                }
                @if (resumen.TotalArtistasConDeuda > 0)
                {
                    <li class="list-group-item" style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo("artistas")'>
                        @resumen.TotalArtistasConDeuda artista(s) con plata pendiente de pago.
                    </li>
                }
            </ul>
        </details>
    }

    <div class="row g-3">
        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-baseline">
                <h2 class="h6 mb-1">Artistas a los que se les debe</h2>
                @if (resumen.TotalArtistasConDeuda > resumen.ArtistasConDeuda.Count)
                {
                    <a class="small" href="artistas">ver todos (@resumen.TotalArtistasConDeuda)</a>
                }
            </div>
            @if (resumen.ArtistasConDeuda.Count == 0)
            {
                <p class="text-body-secondary">No hay saldos pendientes.</p>
            }
            else
            {
                <table class="table table-sm table-striped mb-0">
                    <thead><tr><th>Artista</th><th>Hace cuánto no cobra</th><th class="text-end">Saldo $</th><th class="text-end">Saldo U$S</th></tr></thead>
                    <tbody>
                        @foreach (var artista in resumen.ArtistasConDeuda)
                        {
                            <tr style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo($"liquidaciones/generar?artista={artista.ArtistaId}")'>
                                <td>@artista.ArtistaNombre</td>
                                <td>@Antiguedad(artista.UltimaLiquidacion)</td>
                                <td class="text-end">@Formato.Monto(artista.SaldoPesos, Moneda.Pesos)</td>
                                <td class="text-end">@Formato.Monto(artista.SaldoDolares, Moneda.USD)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="col-md-5">
            <div class="d-flex justify-content-between align-items-baseline">
                <h2 class="h6 mb-1">Últimas ventas</h2>
                <a class="small" href="ventas">ver todas</a>
            </div>
            @if (resumen.UltimasVentas.Count == 0)
            {
                <p class="text-body-secondary">Todavía no hay ventas registradas.</p>
            }
            else
            {
                <table class="table table-sm table-striped mb-0">
                    <thead><tr><th>Fecha</th><th>Obra</th><th class="text-end">Precio</th></tr></thead>
                    <tbody>
                        @foreach (var venta in resumen.UltimasVentas)
                        {
                            <tr>
                                <td>@venta.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>@venta.Titulo</td>
                                <td class="text-end">@Formato.Monto(venta.PrecioVenta, venta.Moneda)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
</div>

@code {
    private ResumenDashboard? resumen;
    private readonly string primerDiaDelMes = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync() =>
        resumen = await ResumenService.ObtenerAsync();

    private static bool HayPendientes(ResumenDashboard r) =>
        r.Avisos.ObrasSinTecnica > 0 || r.Avisos.ObrasSinRubro > 0
        || r.Avisos.RetirosVencidos > 0 || r.Avisos.AlquileresSinFechaRecupero > 0
        || r.TotalArtistasConDeuda > 0;

    // Cuenta de renglones del panel (no de piezas/artistas individuales) — es "cuántas cosas
    // distintas necesitan tu atención", no "cuántas obras/artistas hay en total".
    private static int TotalPendientes(ResumenDashboard r) =>
        (r.Avisos.ObrasSinTecnica > 0 ? 1 : 0) + (r.Avisos.ObrasSinRubro > 0 ? 1 : 0)
        + (r.Avisos.RetirosVencidos > 0 ? 1 : 0) + (r.Avisos.AlquileresSinFechaRecupero > 0 ? 1 : 0)
        + (r.TotalArtistasConDeuda > 0 ? 1 : 0);

    private static string Antiguedad(DateOnly? ultimaLiquidacion)
    {
        if (ultimaLiquidacion is null)
        {
            return "nunca cobró";
        }

        var dias = DateOnly.FromDateTime(DateTime.Now).DayNumber - ultimaLiquidacion.Value.DayNumber;
        return dias <= 0 ? "hoy" : $"hace {dias} día(s)";
    }
}
