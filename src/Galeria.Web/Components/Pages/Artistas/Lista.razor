@page "/artistas"
@attribute [Authorize]
@using Galeria.Application.Artistas
@inject ArtistaService ArtistaService
@inject NavigationManager NavigationManager

<PageTitle>Artistas</PageTitle>
<HeadContent>
    <meta name="description" content="Listado de artistas de la galería, con obras en stock y saldo a pagar." />
</HeadContent>

<h1>Artistas</h1>

<div class="row mb-3 g-2">
    <div class="col-md-6">
        <input class="form-control" placeholder="Buscar por nombre o taller..."
               @bind="texto" @bind:event="oninput" @bind:after='() => IrA("q", texto)' />
    </div>
    <div class="col-md-6 text-end">
        <a class="btn btn-outline-secondary" href="@EnlaceExportarCsv()" target="_blank">Exportar CSV</a>
        <a class="btn btn-primary" href="artistas/nuevo">+ Nuevo artista</a>
    </div>
</div>

@if (artistas is null)
{
    <p><em>Cargando...</em></p>
}
else if (artistas.Count == 0)
{
    <p>No hay artistas que coincidan con la búsqueda.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th role="button" @onclick="() => OrdenarPor(OrdenArtista.Codigo)">Código @Flecha(OrdenArtista.Codigo)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenArtista.Nombre)">Nombre @Flecha(OrdenArtista.Nombre)</th>
                <th role="button" @onclick="() => OrdenarPor(OrdenArtista.Taller)">Taller @Flecha(OrdenArtista.Taller)</th>
                <th>Celular</th>
                <th>Correo</th>
                <th role="button" class="text-end" @onclick="() => OrdenarPor(OrdenArtista.CantidadObras)">Obras @Flecha(OrdenArtista.CantidadObras)</th>
                <th role="button" class="text-end" @onclick="() => OrdenarPor(OrdenArtista.ObrasEnStock)">En stock @Flecha(OrdenArtista.ObrasEnStock)</th>
                <th role="button" class="text-end" @onclick="() => OrdenarPor(OrdenArtista.SaldoPesos)">Saldo $ @Flecha(OrdenArtista.SaldoPesos)</th>
                <th role="button" class="text-end" @onclick="() => OrdenarPor(OrdenArtista.SaldoDolares)">Saldo U$S @Flecha(OrdenArtista.SaldoDolares)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var artista in artistas)
            {
                <tr style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo($"artistas/{artista.Id}")'>
                    <td>@artista.Codigo.ToString("D3")</td>
                    <td>@artista.NombreCompleto</td>
                    <td>@artista.Taller</td>
                    <td>@artista.Celular</td>
                    <td>@artista.Correo</td>
                    <td class="text-end">@artista.CantidadObras</td>
                    <td class="text-end">@artista.ObrasEnStock</td>
                    <td class="text-end">@Formato.Monto(artista.SaldoPesos, Moneda.Pesos)</td>
                    <td class="text-end">@Formato.Monto(artista.SaldoDolares, Moneda.USD)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? TextoLibre { get; set; }
    [SupplyParameterFromQuery(Name = "orden")] public string? OrdenTexto { get; set; }
    [SupplyParameterFromQuery(Name = "desc")] public bool? OrdenDescendente { get; set; }

    private OrdenArtista Orden => Enum.TryParse<OrdenArtista>(OrdenTexto, out var o) ? o : OrdenArtista.Nombre;
    private bool DescActual => OrdenDescendente ?? false;

    private List<ArtistaListItem>? artistas;
    private string? texto;

    protected override void OnInitialized() => texto = TextoLibre;

    protected override async Task OnParametersSetAsync()
    {
        texto = TextoLibre;
        artistas = await ArtistaService.BuscarAsync(new ArtistaFiltro(TextoLibre, Orden, DescActual));
    }

    private void IrA(string clave, object? valor) =>
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> { [clave] = valor }), replace: true);

    private void OrdenarPor(OrdenArtista campo)
    {
        var descNuevo = Orden == campo && !DescActual;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["orden"] = campo.ToString(),
            ["desc"] = descNuevo ? "true" : null
        }), replace: true);
    }

    private string Flecha(OrdenArtista campo) => Orden != campo ? "" : (DescActual ? " ▼" : " ▲");

    private string EnlaceExportarCsv() => "artistas/exportar.csv" + new Uri(NavigationManager.Uri).Query;
}
