@page "/artistas/nuevo"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Galeria.Application.Artistas
@inject ArtistaService ArtistaService
@inject IJSRuntime JS

<PageTitle>Nuevo artista</PageTitle>
<HeadContent>
    <meta name="description" content="Alta de un nuevo artista en la galería." />
</HeadContent>

<div class="page-narrow">
    <h1>Nuevo artista</h1>

    @if (esPopupYaGuardado)
    {
        <div class="alert alert-success">
            "@ultimoGuardado" se creó correctamente con el código @ultimoCodigo?.ToString("D3"). Podés cerrar
            esta pestaña y volver al formulario anterior (si no se cerró sola, cerrala con la X de arriba).
        </div>
    }
    else if (mensaje is not null)
    {
        <div class="alert alert-success alert-dismissible">
            @mensaje
            <a class="btn btn-sm btn-outline-secondary ms-2" href="artistas">Ver en la lista</a>
            <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
        </div>
    }

    <EditForm Model="Input" OnValidSubmit="GuardarAsync" FormName="nuevo-artista" data-enhance="false">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido</label>
                <InputText class="form-control" @bind-Value="Input.Apellido" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="Input.Nombre" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Taller</label>
                <InputText class="form-control" @bind-Value="Input.Taller" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Dirección</label>
                <InputText class="form-control" @bind-Value="Input.Direccion" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Celular</label>
                <InputText class="form-control" @bind-Value="Input.Celular" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Teléfono fijo</label>
                <InputText class="form-control" @bind-Value="Input.TelFijo" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Correo</label>
                <InputText class="form-control" @bind-Value="Input.Correo" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Perfil / notas</label>
            <InputTextArea class="form-control" @bind-Value="Input.Perfil" rows="2" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : "Guardar")</button>
        <a href="artistas" class="btn btn-outline-danger">Cancelar</a>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private int guardandoFlag;
    private bool guardando => guardandoFlag != 0;
    private bool esPopupYaGuardado;
    private string? ultimoGuardado;
    private int? ultimoCodigo;
    private string? mensaje;

    private async Task GuardarAsync()
    {
        if (Interlocked.CompareExchange(ref guardandoFlag, 1, 0) != 0) return;

        try
        {
            var request = new CrearArtistaRequest(
                Input.Apellido.Trim(),
                Input.Nombre.Trim(),
                Input.Taller,
                Input.Celular,
                Input.TelFijo,
                Input.Direccion,
                Input.Correo,
                Input.Perfil);

            var resultado = await ArtistaService.CrearAsync(request);

            // Si este formulario se abrió en una pestaña nueva (ej. "Crealo acá" desde Nueva
            // obra), se cierra sola en vez de dejar dos pestañas abiertas al mismo tiempo.
            if (await JS.InvokeAsync<bool>("navHistorial.cerrarSiEsPopup"))
            {
                ultimoGuardado = $"{request.Apellido}, {request.Nombre}";
                ultimoCodigo = resultado.Codigo;
                esPopupYaGuardado = true;
                return;
            }

            // Punto 21 del testeo de cliente: mostrar el código asignado en el momento, en vez de
            // navegar directo a la lista y que tenga que ir a buscarlo. Se queda en el formulario
            // (mismo patrón que Obras/Nueva.razor) por si quiere seguir cargando artistas seguidos.
            mensaje = $"\"{request.Apellido}, {request.Nombre}\" se creó con el código {resultado.Codigo:D3}.";
            Input = new InputModel();
        }
        finally
        {
            guardandoFlag = 0;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El apellido es obligatorio.")]
        [MaxLength(100)]
        public string Apellido { get; set; } = "";

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(100)]
        public string Nombre { get; set; } = "";

        [MaxLength(200)]
        public string? Taller { get; set; }

        [MaxLength(30)]
        public string? Celular { get; set; }

        [MaxLength(30)]
        public string? TelFijo { get; set; }

        [MaxLength(300)]
        public string? Direccion { get; set; }

        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        [MaxLength(200)]
        public string? Correo { get; set; }

        [MaxLength(2000)]
        public string? Perfil { get; set; }
    }
}
