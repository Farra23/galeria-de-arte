@page "/alquileres/nueva"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Galeria.Application.Alquileres
@using Galeria.Application.Obras
@inject AlquilerService AlquilerService
@inject NavigationManager NavigationManager

<PageTitle>Nuevo alquiler</PageTitle>
<HeadContent>
    <meta name="description" content="Registrar el alquiler de una o varias obras con el reparto entre galería y artista." />
</HeadContent>

<div class="page-form">
<h1>Nuevo alquiler</h1>

@if (error is not null)
{
    <ul class="text-danger" role="alert"><li>@error</li></ul>
}

@if (!continuar)
{
    <div class="mb-3">
        <label class="form-label">Buscar obra por código, nombre o artista</label>
        <input class="form-control" @bind="texto" @bind:event="oninput" @bind:after="BuscarAsync" autofocus />
    </div>

    @if (resultados is not null)
    {
        @if (resultados.Count == 0)
        {
            <p class="mt-3">No se encontraron obras disponibles con ese criterio.</p>
        }
        else
        {
            <div class="table-responsive">
            <table class="table table-striped mt-3">
                <thead><tr><th></th><th>Código</th><th>Nombre</th><th>Artista</th><th class="text-end">Precio</th></tr></thead>
                <tbody>
                    @foreach (var item in resultados)
                    {
                        <tr style="cursor:pointer" @onclick="() => Marcar(item, true)">
                            <td><input type="checkbox" class="form-check-input" checked="@seleccion.ContainsKey(item.Id)" @onclick:stopPropagation="true" @onclick="() => Alternar(item)" /></td>
                            <td>@item.CodigoVisible</td>
                            <td>@item.Titulo</td>
                            <td>@item.ArtistaNombre</td>
                            <td class="text-end">@Formato.Monto(item.PrecioVenta, item.Moneda)</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }

    @if (seleccion.Count > 0)
    {
        <div class="alert alert-light border d-flex justify-content-between align-items-center">
            <span>@seleccion.Count obra(s) marcada(s) para alquilar.</span>
            <button type="button" class="btn btn-primary" @onclick="() => continuar = true">Continuar</button>
        </div>
    }
}
else
{
    <div>
        <h2 class="h5">@seleccion.Count obra(s) a alquilar</h2>

        <EditForm Model="Input" OnValidSubmit="ConfirmarAsync" FormName="nuevo-alquiler" data-enhance="false">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label">Fecha de inicio</label>
                    <InputDate class="form-control" @bind-Value="Input.FechaInicio" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Recupero previsto</label>
                    <InputDate class="form-control" @bind-Value="Input.FechaRecupero" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">% de alquiler (sobre precio de venta)</label>
                    <InputNumber TValue="decimal" class="form-control" Value="Input.PorcentajeAlquiler" ValueChanged="OnPorcentajeAlquilerChanged" ValueExpression="() => Input.PorcentajeAlquiler" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">% que le toca al artista</label>
                    <InputNumber TValue="decimal" class="form-control" Value="Input.PorcentajeArtista" ValueChanged="OnPorcentajeArtistaChanged" ValueExpression="() => Input.PorcentajeArtista" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Cliente (quien paga el alquiler)</label>
                <InputText class="form-control" @bind-Value="Input.Cliente" />
            </div>

            <div class="table-responsive mb-3">
                <table class="table table-sm">
                    <thead><tr><th></th><th>Obra</th><th class="text-end">Alquiler</th><th class="text-end">Artista</th><th class="text-end">Galería</th></tr></thead>
                    <tbody>
                        @foreach (var item in seleccion.Values)
                        {
                            var reparto = AlquilerService.CalcularReparto(item.PrecioVenta, Input.PorcentajeAlquiler, Input.PorcentajeArtista);
                            <tr>
                                <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Quitar(item.Id)">Quitar</button></td>
                                <td>@item.CodigoVisible — @item.Titulo</td>
                                <td class="text-end">@Formato.Monto(reparto.MontoAlquiler, item.Moneda)</td>
                                <td class="text-end">@Formato.Monto(reparto.MontoArtista, item.Moneda)</td>
                                <td class="text-end">@Formato.Monto(reparto.MontoGaleria, item.Moneda)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@guardando">@(guardando ? "Guardando…" : seleccion.Count > 1 ? $"Confirmar {seleccion.Count} alquileres" : "Confirmar alquiler")</button>
            <button type="button" class="btn btn-link text-danger" @onclick="Cancelar">Cancelar</button>
        </EditForm>
    </div>
}
</div>

<ConfirmModal @ref="confirmModal" />

@code {
    private string? texto;
    private List<ObraParaOperacion>? resultados;
    private readonly Dictionary<int, ObraParaOperacion> seleccion = [];
    private bool continuar;
    private string? error;
    private int guardandoFlag;
    private bool guardando => guardandoFlag != 0;
    private InputModel Input { get; set; } = new();
    private ConfirmModal confirmModal = default!;

    private async Task BuscarAsync() => resultados = await AlquilerService.BuscarObrasDisponiblesAsync(texto);

    private void Marcar(ObraParaOperacion item, bool valor)
    {
        if (valor) seleccion[item.Id] = item;
        else seleccion.Remove(item.Id);
    }

    private void Alternar(ObraParaOperacion item) => Marcar(item, !seleccion.ContainsKey(item.Id));

    private void Quitar(int obraId)
    {
        seleccion.Remove(obraId);
        if (seleccion.Count == 0)
        {
            Cancelar();
        }
    }

    private void OnPorcentajeAlquilerChanged(decimal valor)
    {
        Input.PorcentajeAlquiler = valor;
        StateHasChanged();
    }

    private void OnPorcentajeArtistaChanged(decimal valor)
    {
        Input.PorcentajeArtista = valor;
        StateHasChanged();
    }

    private void Cancelar()
    {
        seleccion.Clear();
        continuar = false;
        error = null;
        Input = new InputModel { FechaInicio = DateTime.Now };
    }

    private void ConfirmarAsync()
    {
        error = null;

        var mensaje = seleccion.Count == 1
            ? $"¿Confirmás el alquiler de \"{seleccion.Values.First().Titulo}\"?"
            : $"¿Confirmás el alquiler de las {seleccion.Count} obras marcadas?";

        confirmModal.Mostrar("Confirmar alquiler", mensaje, RegistrarAsync, "Confirmar alquiler");
    }

    private async Task RegistrarAsync()
    {
        if (Interlocked.CompareExchange(ref guardandoFlag, 1, 0) != 0) return;

        try
        {
            var fallidas = new List<string>();

            foreach (var item in seleccion.Values.ToList())
            {
                try
                {
                    var request = new RegistrarAlquilerRequest(
                        item.Id,
                        DateOnly.FromDateTime(Input.FechaInicio),
                        Input.FechaRecupero.HasValue ? DateOnly.FromDateTime(Input.FechaRecupero.Value) : null,
                        Input.PorcentajeAlquiler,
                        Input.PorcentajeArtista,
                        Input.Cliente);

                    await AlquilerService.RegistrarAsync(request);
                    seleccion.Remove(item.Id);
                }
                catch (InvalidOperationException ex)
                {
                    fallidas.Add($"{item.CodigoVisible} — {item.Titulo}: {ex.Message}");
                }
            }

            if (fallidas.Count > 0)
            {
                error = "No se pudo registrar el alquiler de: " + string.Join(" | ", fallidas);
            }

            if (seleccion.Count == 0)
            {
                NavigationManager.NavigateTo("alquileres");
            }
        }
        finally
        {
            guardandoFlag = 0;
            StateHasChanged();
        }
    }

    private sealed class InputModel
    {
        public DateTime FechaInicio { get; set; } = DateTime.Now;

        public DateTime? FechaRecupero { get; set; }

        [Range(typeof(decimal), "0.01", "100", ErrorMessage = "Tiene que ser un porcentaje entre 0 y 100.", ParseLimitsInInvariantCulture = true)]
        public decimal PorcentajeAlquiler { get; set; } = 10;

        [Range(typeof(decimal), "0", "100", ErrorMessage = "Tiene que ser un porcentaje entre 0 y 100.", ParseLimitsInInvariantCulture = true)]
        public decimal PorcentajeArtista { get; set; } = 50;

        [MaxLength(200)]
        public string? Cliente { get; set; }
    }
}
