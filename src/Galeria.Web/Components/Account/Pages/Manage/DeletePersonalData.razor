@page "/Account/Manage/DeletePersonalData"

<PageTitle>Eliminar cuenta</PageTitle>

<StatusMessage Message="@message" />

<h3>Eliminar cuenta</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Esta acción no está disponible.</strong> Ninguna cuenta de usuario se borra en este sistema — un administrador
        puede bloquear el acceso desde Configuración → Usuarios, pero el historial y la cuenta se conservan siempre.
    </p>
</div>

@code {
    private string? message = "Si necesitás dar de baja tu acceso, pedile a un administrador que te bloquee desde Configuración → Usuarios.";
}
